  "implementation_design": {
    "domain_forces": [
      "A test case with 20 criteria still paid for a suggestion none of whose proposals could be adopted, and one with 19 paid for up to 20 proposals of which one fitted."
    ],
    "decision": "Count the criteria before admission and refuse with 413 when the list is full; cap the proposals at the room left. The page disables adding and suggesting when the list is full.",
    "invariants_preserved": [
      "A refused suggestion calls no model and charges nothing.",
      "Proposals already in the list are never offered again."
    ],
    "rejected_alternatives": [
      "Asking the model for exactly the room left: the model may still return more, so the cap stays on our side."
    ],
    "proof_obligations": [
      "rule-a-criteria-suggestion-is-paid-for-by-its-requester"
    ],
    "counterfactual_check": "Allowing a full list past the count check fails TestSuggestionsFillOnlyTheRoomLeftAndAFullListIsRefusedBeforeTheModel with 200 instead of 413."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-criteria-suggestion-is-paid-for-by-its-requester",
        "statement": "Suggesting acceptance criteria is a model call the user starts, so it is open only to invited accounts, refused before the model is called when the test case already holds the most criteria it may or when the owner's credit balance is below the start threshold for suggest_criteria, and debited by the usage the gateway reported once the model answers; it never proposes more criteria than there is room for.",
        "contexts": [
          "testlab"
        ],
        "examples": [
          "With no suggest_criteria statistics the threshold is the 70-credit fallback: a balance of 69 is refused with no model call and nothing charged; a balance of 70 is allowed and a $0.01 answer debits 13 credits at the default markup.",
          "With 19 of 20 criteria a suggestion answers with one proposal out of three; with 20 it answers 413 and the model is not called."
        ],
