{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed private search evidence for tool_call",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "source_urls",
    "cost_usd",
    "truncated"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "source_urls": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
