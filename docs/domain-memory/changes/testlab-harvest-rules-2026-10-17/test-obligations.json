      "source_id": "enforced-simulated-user-facts-stay-within-their-limits",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "simulated-user-facts-stay-within-their-limits"
        }
      ],
      "expected_outcome": "A simulated user holds at most MaxSimulatedUserFacts non-blank facts totalling at most MaxSimulatedUserFactsChars characters; anything else is refused.",
