        }
      ],
      "expected_outcome": "A Test Case's name and prompt must be non-blank and within their limits, counted in characters so Han text is not penalised for its byte length.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestTextLimitsCountCharactersNotBytes$ ./internal/trial/design/"
    },
    {
