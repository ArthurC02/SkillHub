        {
          "source_type": "rule",
          "source_id": "a-continuation-prompt-is-held-to-the-prompt-limit"
        }
      ],
      "expected_outcome": "A continued snapshot's prompt may not exceed MaxPromptChars characters, counted as characters, not bytes.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestAContinuationPromptIsHeldToThePromptLimit$ ./internal/trial/design/"
    },
    {
      "id": "rule-test-case-text-limits-count-characters",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-test-case-text-limits-count-characters",
      "also_covers": [
        {
          "source_type": "rule",
