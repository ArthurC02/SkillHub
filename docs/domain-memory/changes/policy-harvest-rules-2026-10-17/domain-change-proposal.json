  "ownership_decision": {
    "owner_context": "policy",
    "invariant": "Only policy decides whether an allowance permits one more run or generation and how long downloads are kept.",
    "evidence": [
      "apps/platform/internal/product/entitlements/quota.go:169-196",
      "apps/platform/internal/product/entitlements/retention.go:12-17"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: usage arrives through the UsageReader port; run and generation callers map the sentinels.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/product/entitlements/quota.go:175-181"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the policy Context found these enforced rules; the reviewed Registry held none, so the next Agent could not look them up."
    ],
    "decision": "Record the eight rules as reviewed citing code and test; no product code change.",
    "invariants_preserved": [
      "An allowance that cannot be counted never reads as unused."
    ],
    "rejected_alternatives": [
      "Recording the first-window allowance for a young Workspace: the tests pin only the constants, and no test fails if the first-window selection is broken, so it waits for one."
    ],
    "proof_obligations": [
      "rule-a-spent-daily-allowance-refuses-the-next-run",
      "rule-a-spent-window-allowance-refuses-the-next-run",
      "rule-an-uncountable-allowance-refuses-without-claiming-it-ran-out",
      "rule-generation-and-run-allowances-are-separate",
      "rule-an-allowance-needs-a-window-and-a-ceiling",
      "rule-remaining-allowance-is-never-negative",
      "rule-the-default-run-allowance",
      "rule-download-retention-must-be-positive"
    ],
    "counterfactual_check": "Break each rule's enforcing line so the package still builds; its test must fail with that rule's own assertion."
  },
