  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "run",
    "invariant": "Only run decides whether dispatch is paused or halted by a P1; each consumer decides what its own refusal looks like.",
    "evidence": [
      "apps/platform/internal/trial/execution/halt.go:22-59",
      "apps/platform/internal/entrypoint/api/apiserver/app.go:654-661"
    ]
  },
  "boundary_decision": {
    "interaction": "run-ingest-model-call-halt, run-testlab-model-call-halt and run-creation-model-call-halt: the composition root hands each consumer run's dispatch gate as a hook; batch reads the same gate through its existing StartRun port.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "ingest, testlab or creation importing run"
    ],
    "evidence": [
      "apps/platform/internal/trial/execution/halt.go:22-59",
      "apps/platform/internal/entrypoint/api/apiserver/app.go:654-661"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A P1 halt stopped new runs but generation, creation steps and criteria suggestions kept calling the model, so spending continued through the incident.",
      "Under an orphan-threshold halt queued runs could not be dispatched yet their slot-wait clock kept running, and batches kept creating trials that then timed out unevaluated."
    ],
    "decision": "Expose run's dispatch gate as a type with its own methods, hand ModelCallsHalted to the three model-calling contexts through their spend-admission hooks, extend a queued run's deadline by the time dispatch was paused over its wait, and make the batch wait while dispatch is paused.",
    "invariants_preserved": [
      "A refused call charges nothing.",
      "An orphan halt still lets people queue runs.",
      "A P1 halt is never lifted automatically."
    ],
    "rejected_alternatives": [
      "Restarting the queue clock when a halt lifts: it would give a run caught by two short halts more wait than the time it was actually held.",
      "Refusing run creation under an orphan halt: it would turn an automatically recovering halt into user-visible refusals."
    ],
    "proof_obligations": [
      "rule-user-started-model-calls-stop-under-a-p1-halt",
      "rule-time-dispatch-was-paused-does-not-count-against-the-slot-wait",
      "rule-a-batch-starts-no-trial-while-dispatch-is-paused",
      "rule-an-unaccepted-run-expires-after-the-slot-wait-limit"
    ],
    "counterfactual_check": "Dropping the held time from the slot-wait deadline fails TestTimeTheQueueSpentHaltedDoesNotCountAgainstTheSlotWaitLimit."
  },
