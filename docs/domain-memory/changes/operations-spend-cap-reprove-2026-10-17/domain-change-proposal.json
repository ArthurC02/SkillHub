      "record": {
        "id": "agent-daily-spend-cap-is-operator-adjustable-under-a-ceiling",
        "statement": "A platform agent's effective daily spend cap is the operator's override when one is set, otherwise the default its definition declares. An override must be above zero and at most US$5 a day, and re-registering the definitions replaces only the default, never the override.",
        "contexts": [
          "operations"
        ],
        "examples": [
          "An operator raising an agent's cap to 5000000 micros takes effect at that agent's next run; 5000001 micros is refused.",
          "Clearing the override returns the agent to the default its definition declares.",
          "A worker restart re-registers every definition and the operator's override survives it."
        ],
