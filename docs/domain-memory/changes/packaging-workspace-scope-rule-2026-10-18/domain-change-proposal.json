    "owner_context": "packaging",
    "invariant": "Only packaging serves download artifacts, always within the asking Workspace.",
    "evidence": [
      "apps/platform/internal/skill/delivery/download.go:159-170"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged.",
