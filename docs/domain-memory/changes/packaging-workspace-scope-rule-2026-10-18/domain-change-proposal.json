  "implementation_design": {
    "domain_forces": [
      "Dropping the Workspace id breaks the owner's reads too, so earlier counterfactuals could not isolate scoping. Weakening only the Workspace predicate in the generated query lets another Workspace's rows through while the owner's still match, and a stranger test catches it."
    ],
    "decision": "Record the scoping rule as reviewed citing the call that passes the Workspace and the stranger test; no product code change.",
    "invariants_preserved": [
      "A Workspace never reads or spends another Workspace's data."
    ],
    "rejected_alternatives": [
      "Mutating the call to pass an empty Workspace id: it empties the owner's reads as well and proves nothing about strangers."
    ],
    "proof_obligations": [
      "rule-a-download-is-read-only-within-its-workspace"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
