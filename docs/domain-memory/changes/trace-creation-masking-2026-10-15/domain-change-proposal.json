    "owner_context": "trace",
    "invariant": "Secret masking rules have one owner, trace; creation applies trace's masker to every page it fetches and message it stores.",
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/creation_references.go:24-24"
    ]
  },
  "boundary_decision": {
    "interaction": "creation receives trace's MaskString through the composition root and never imports trace.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/creation_references.go:24-24"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "Creation stores fetched pages and model messages that can carry secrets; a second set of masking rules would drift from trace and its canary."
    ],
    "decision": "Keep the masker in trace and record creation's use of it as a composition-root interaction, guarded by a wiring test that redacts a real secret shape.",
    "invariants_preserved": [
      "Creation never imports trace.",
      "One masker, one canary."
    ],
    "rejected_alternatives": [
      "Moving the masker to a foundation package: trace's canary and P1 detector watch that masker, so its rules would leave the Context that answers for them."
    ],
    "proof_obligations": [
      "creation-masks-with-trace"
    ],
    "counterfactual_check": "Drop the masker assignment, or hand creation an identity mask; TestCreationRedactsSecretsWithTheTraceMasker must fail."
  },
