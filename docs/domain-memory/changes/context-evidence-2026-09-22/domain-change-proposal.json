  "implementation_design": {
    "domain_forces": [
      "Both Contexts were evidenced by rows of the Context Map, a document scheduled for removal once this Plugin can carry what it holds.",
      "A record whose evidence lives in a document that is going away loses its evidence when that document goes.",
      "The responsibility of a Context is stated by the package that holds it, in that package's own doc comment, which is where it is least likely to drift from the code."
    ],
    "decision": "Cite the owning package's doc comment for each responsibility and the boundary decision for each name, and stop citing the Context Map.",
    "invariants_preserved": [
      "Run owns lifecycle transitions."
    ],
    "rejected_alternatives": [
      "Copy the responsibilities into a decision document: the package doc comment is closer to the code and already says it.",
      "Keep the Context Map citation alongside the new one: the dependency is the thing being removed.",
      "Leave the records as they are until the Context Map is actually deleted: that schedules a broken Registry instead of preventing one."
    ],
    "proof_obligations": [
      "registry-structurally-valid",
      "cited-evidence-current",
      "a-context-needs-its-responsibility",
      "no-citation-into-the-retired-map",
      "audit-chain-intact",
      "approval-path-is-external"
    ],
    "counterfactual_check": "a-context-needs-its-responsibility"
  },
