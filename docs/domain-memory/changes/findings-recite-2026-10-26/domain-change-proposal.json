    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "only-an-enriched-or-embedded-document-is-listable",
        "statement": "A search document is listable only once its enrichment is finished or it has an embedding a vector search can find. An enrichment whose embedding call failed is still stored as enriched, without a vector, so it is listable at once; the enrichment backfill later embeds that stored text without calling the enrichment model again, and stores the vector only if the document has not been rewritten since it was claimed.",
        "contexts": [
          "catalog"
        ],
        "examples": [
          "A pending document without a vector is not listable; the same document with a vector is.",
          "The enrichment answers and the embedding call fails: the document is enriched and listable without a vector; the next backfill pass makes one embedding call and no enrichment call, and a vector computed before a re-import rewrote the document is dropped."
        ],
