  "implementation_design": {
    "domain_forces": [
      "版本停用檢查使同一檔案在舊引用範圍之前增加程式碼。",
      "已審查記錄的程式片段內容沒變，但起訖行與全檔摘要因此失效。"
    ],
    "decision": "只更新既有互動的結構化引用，不擴張其契約或改寫領域事實。",
    "invariants_preserved": [
      "Registry 擁有 Version 事實；Run 透過注入的 reader 讀取。"
    ],
    "rejected_alternatives": [
      "保留失效引用，讓機器無法再確認已審查事實。",
      "為了保住行號而壓縮程式碼、犧牲可讀性。"
    ],
    "proof_obligations": [
      "citation-current",
      "reader-behavior-current",
      "citation-counterfactual"
    ],
    "counterfactual_check": "舊引用對目前程式碼回報 stale；新引用通過 verify-evidence，且 reader 缺席的拒絕測試通過。"
  },
