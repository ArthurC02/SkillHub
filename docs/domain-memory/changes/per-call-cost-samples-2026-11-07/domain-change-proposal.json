  "ownership_decision": {
    "owner_context": "credit",
    "invariant": "The start statistics of a cost kind sample its model calls; a debit covering several reported calls lists their costs, which sum to it.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "eval hands each answered call's reported cost to credit through the testlab charge hook in the composition root; credit stores and aggregates the samples in its own cost_events and never reads an eval table.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "credit reading batch_reflections"
    ],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "A round of K calls is one debit, so p95 over debits grows with K and threshold times K would count the calls twice.",
      "The samples belong to the context that computes the statistic.",
      "A call whose cost the gateway did not report has no measured sample."
    ],
    "decision": "cost_events.call_usd_micros lists the calls of a debit of two or more fully reported calls; AggregateCostEventsWindow unnests coalesce(call_usd_micros, ARRAY[usd_micros]); Charge and a CHECK refuse a list that is not two or more non-negative costs summing to a gateway-measured usd_micros; roundUsage carries the per-call costs and the charge hook converts each with BillableMicros.",
    "invariants_preserved": [
      "A round is still one debit.",
      "Every event without a list is one sample, so other kinds and earlier rounds keep their statistics.",
      "A round with any unreported call is charged by the token estimate as before."
    ],
    "rejected_alternatives": [
      "Storing per-call usage on batch_reflections candidate outcomes, which would make credit read an eval table.",
      "A separate per-call sample table, which adds a write for a list that is frozen with its one event.",
      "Dividing a round's debit by K, which hides the spread between calls."
    ],
    "proof_obligations": [
      "rule-a-start-statistic-samples-model-calls-not-debits",
      "single-call-kinds-unchanged",
      "calls-list-constraint",
      "rule-a-batch-reflection-is-paid-for-by-its-requester",
      "priced-round-lists-its-calls"
    ],
    "counterfactual_check": "Unnest only the first two listed calls: the window must report 3 samples and fail. Allow one listed call in Charge: the decision table must fail. Drop the list in the charge hook: the priced K = 3 round must fail."
  },
  "event_change": null,
