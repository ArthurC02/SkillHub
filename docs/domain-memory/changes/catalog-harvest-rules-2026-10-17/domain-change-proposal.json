    "owner_context": "catalog",
    "invariant": "Only catalog decides what a reader can find, list and open from the Catalog.",
    "evidence": [
      "apps/platform/internal/skill/discovery/service.go:345-350",
      "apps/platform/internal/skill/discovery/detail.go:566-573"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: exposure still arrives from publishing through the injected ExposedSkills reader.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/skill/discovery/exposure.go:84-101"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the catalog Context found these enforced rules; the reviewed Registry held none, so the next Agent could not look them up."
    ],
    "decision": "Record the seven rules as reviewed citing code and test; no product code change.",
    "invariants_preserved": [
      "A Catalog read is always scoped to the known catalog Workspaces."
    ],
    "rejected_alternatives": [
      "Recording the exposed detail's version and digest match: publishing already filters exposure by the same comparison, so no test can break discovery's copy alone without a database stub; it waits for a test that can."
    ],
    "proof_obligations": [
      "rule-a-taken-down-catalog-skill-answers-gone",
      "rule-a-detail-carries-a-restriction-only-while-one-is-in-effect",
      "rule-an-unrecognised-redistribution-reads-as-unconfirmed",
      "rule-only-an-enriched-or-embedded-document-is-listable",
      "rule-only-a-curated-listing-names-its-reviewed-version",
      "rule-catalog-reads-refuse-without-the-catalog-workspaces",
      "rule-a-search-purpose-is-reference-or-absent"
    ],
    "counterfactual_check": "Break each rule's enforcing line so the package still builds; its test must fail with that rule's own assertion."
  },
