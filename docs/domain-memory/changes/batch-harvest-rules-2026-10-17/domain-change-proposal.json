  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the batch Context found these enforced rules; the reviewed Registry held one.",
      "A counterfactual over the whole suite showed no test reached the creator_gone stop; a test was added."
    ],
    "decision": "Record the rules as reviewed citing code and test; no product code change.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Recording guards no test reaches: they wait for a test.",
      "Recording Workspace scoping of batch reads: dropping the scope breaks every read, so no test isolates the stranger case."
    ],
    "proof_obligations": [
      "rule-a-batch-has-1-to-10-trials-and-1-to-50-distinct-test-cases",
      "rule-a-batch-needs-every-test-case-confirmed",
