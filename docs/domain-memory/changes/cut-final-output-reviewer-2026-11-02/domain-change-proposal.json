  "implementation_design": {
    "domain_forces": [
      "The runtime cuts a final output at its size limit and marks the event truncated.",
      "A value or a length the check could not see is unknown, not absent: insufficient evidence answers cannot tell, not no."
    ],
    "decision": "The trace summary carries final_output_truncated; Material.FinalOutputCut gives the reason with the kept character count; contains_values turns a miss into undetermined and the length limits turn a within-limit result into undetermined when it is set; the judge adds final_output to its truncation list for a runtime cut as it does for its own.",
    "invariants_preserved": [
      "A pass is never recorded on incomplete evidence.",
      "A value found in the kept part still passes and a kept part over the limit still fails.",
      "Trace gaps that do not touch the final output do not soften a fail."
    ],
    "rejected_alternatives": [
      "Only showing the cut on the page, which leaves the verdict wrong.",
      "Treating any cut as making all evidence incomplete, which would also withhold passes that the kept part proves."
    ],
    "proof_obligations": [
      "rule-a-check-on-a-cut-final-output-cannot-fail-on-what-was-cut",
      "judge-runtime-cut"
    ],
    "counterfactual_check": "Making FinalOutputCut ignore the truncated flag makes the cut-answer rows of TestEachRuleCheckDecidesFromTheRunsOwnRecords fail."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
