      "record": {
        "id": "a-check-on-a-cut-final-output-cannot-fail-on-what-was-cut",
        "statement": "When the runtime cut the final output, a check that reads it records undetermined, not failed, for a value it cannot find, and undetermined, not passed, for a length within the limit; a value found in the kept part still passes and a kept part already over the limit still fails.",
        "contexts": [
