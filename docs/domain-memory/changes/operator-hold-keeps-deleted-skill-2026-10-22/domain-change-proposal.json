  "ownership_decision": {
    "owner_context": "registry",
    "invariant": "Only registry decides when a deleted skill's row and versions may be purged; an operator hold is read from the skill's own takedown and restriction columns.",
    "evidence": [
      "apps/platform/internal/skill/library/purge.go:126-134",
      "db/queries/governance.sql:228-231"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/skill/library/purge.go:126-134",
      "db/queries/governance.sql:228-231"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "An owner could delete a skill an operator had taken down or restricted, and the sweep would purge it after the grace period, leaving nothing to show what had been taken down."
    ],
    "decision": "While an operator takedown or access restriction is in force, an owner's delete still hides the skill from the owner's list and search, but the deleted-skill sweep keeps its row and versions; lifting the takedown or clearing the restriction works on the deleted skill, does not return it to search, and lets the next sweep purge it. An account purge is unchanged.",
    "invariants_preserved": [
      "An owner's own takedown is not a hold.",
      "A lifted takedown never re-lists a deleted skill.",
      "An account purge still erases the account's skills."
    ],
    "rejected_alternatives": [
      "Refusing the owner's delete: the owner keeps the right to remove it from their own view; only the content is preserved."
    ],
    "proof_obligations": [
      "rule-a-held-skill-is-not-purged"
    ],
    "counterfactual_check": "Removing skillsUnderOperatorHold from deletionHolds fails TestAnOwnerDeletionUnderAnOperatorHoldKeepsTheContentUntilTheOperatorReleasesIt."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-held-skill-is-not-purged",
        "statement": "A purge keeps the row of a skill that has test cases or a version referenced by a run, a download or a bundle; the deleted-skill sweep also keeps a skill while its publication is unretired or retired less than the ninety-day name hold ago, and while an operator takedown or access restriction is in force on it.",
        "contexts": [
          "registry"
        ],
        "examples": [
          "A deleted skill past grace that has test cases survives the sweep.",
          "A deleted skill whose publication retired 89 days 23 hours ago survives the sweep; at 90 days and a minute it is purged.",
          "A skill its owner deleted while an operator takedown was in force survives the sweep past grace; after the operator lifts the takedown the next sweep purges it."
        ],
