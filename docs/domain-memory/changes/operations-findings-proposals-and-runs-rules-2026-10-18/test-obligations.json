  "obligations": [
    {
      "id": "rule-a-closed-finding-reopens-only-within-30-days",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-closed-finding-reopens-only-within-30-days",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-closed-finding-reopens-only-within-30-days"
        }
      ],
      "expected_outcome": "A new sighting reopens a closed finding only when it was last seen within 30 days; after that it opens a new finding.",
      "level": "integration",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestAResolvedFindingIsReopenedOnlyWhenLastSeenWithinThirtyDays$ ./internal/entrypoint/api/apiserver/"
    },
    {
      "id": "rule-an-operator-change-note-is-at-most-1000-characters",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-an-operator-change-note-is-at-most-1000-characters",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "an-operator-change-note-is-at-most-1000-characters"
        }
      ],
      "expected_outcome": "An operator's note on an agent change is at most the contract's cap counted in characters; one more is refused with 400.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestAnOperatorNoteIsAtMostTheCapCountedInCharacters$ ./internal/product/operations/"
    },
