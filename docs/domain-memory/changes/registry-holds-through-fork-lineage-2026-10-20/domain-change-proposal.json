  "implementation_design": {
    "domain_forces": [
      "A hold placed after a fork was made did not reach the fork, and operators cannot see private forks to reach them."
    ],
    "decision": "Read the nearest restricted ancestor into every gate's Skill facts without writing the fork's row.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Writing the hold into every fork's row: it writes another workspace's data and misses a later lift."
    ],
    "proof_obligations": [
      "rule-a-licensing-hold-reaches-forks-through-their-lineage"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-licensing-hold-reaches-forks-through-their-lineage",
        "statement": "A Skill without its own access restriction carries the nearest restricted ancestor's along its fork lineage, so a hold placed after a fork was made still holds the fork, without the fork's row being written.",
        "contexts": [
          "registry"
        ],
        "examples": [
          "A hold on the grandparent withholds the grandchild fork's download; lifting it restores the download."
        ],
