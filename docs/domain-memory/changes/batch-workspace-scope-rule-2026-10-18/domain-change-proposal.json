  "ownership_decision": {
    "owner_context": "batch",
    "invariant": "Only batch reads its batches, always within the asking Workspace.",
    "evidence": [
      "apps/platform/internal/trial/batch/batch.go:304-313"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged.",
    "consistency": "synchronous",
