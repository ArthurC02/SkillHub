    "a-test-case-suggestion-is-paid-for-by-its-requester"
  ],
  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "testlab",
    "invariant": "A test case suggestion calls the model only after the owner's balance meets the suggest_test_cases start threshold and model calls are not halted, debits the reported usage once it answers, and stores nothing.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "credit prices the call through the existing credit-testlab-spend composition-root hook, now parameterised by cost kind; run's dispatch gate halts it through the existing run-testlab-model-call-halt hook. testlab imports neither.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "The user starts the call, so they pay for it, as with criteria suggestion.",
      "A proposal is not a test case until the user adopts it through the ordinary create route.",
      "testlab.Service is held at its method budget."
    ],
    "decision": "testlab.TestCaseSuggestions reuses SuggestBilling admit and charge with its own cost kind suggest_test_cases; the composition root wires the same hooks for both suggestion kinds.",
    "invariants_preserved": [
      "Criteria suggestion keeps its own cost kind and messages.",
      "No test case or criterion is written by the suggestion call.",
      "Model calls go through the gateway via apps/llm; Go decides admission, debit and refusal."
    ],
    "rejected_alternatives": [
      "Reusing suggest_criteria as the cost kind, which would mix two features in the start-threshold statistics.",
      "Writing proposals as draft test cases, which would leave the user deleting what was decided for them."
    ],
    "proof_obligations": [
      "rule-a-test-case-suggestion-is-paid-for-by-its-requester",
      "debited-and-stores-nothing",
      "halted-refused"
    ],
    "counterfactual_check": "Skip the admission in TestCaseSuggestions.Suggest; the below-threshold test must fail because the model is called and charged."
  },
  "event_change": null,
  "contract_change": null,
