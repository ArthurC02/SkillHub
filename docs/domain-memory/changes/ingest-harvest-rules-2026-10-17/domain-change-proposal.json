      "rule-a-new-version-keeps-the-skills-name",
      "rule-a-source-records-the-provenance-its-kind-requires",
      "rule-generated-and-uploaded-skills-do-not-share-a-name"
    ],
    "counterfactual_check": "Break each rule's enforcing line so the package still builds; its test must fail with that rule's own assertion."
  },
