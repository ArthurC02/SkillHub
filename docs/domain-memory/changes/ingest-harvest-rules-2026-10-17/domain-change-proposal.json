  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the ingest Context found these enforced rules; the reviewed Registry held none, so the next Agent could not look them up."
    ],
    "decision": "Record the seven rules as reviewed citing code and test; no product code change.",
    "invariants_preserved": [
      "A Skill Version is never overwritten."
    ],
    "rejected_alternatives": [
      "Recording the refusal of an improvement whose base version moved: no test reaches ErrBaseVersionMoved, so it waits for one."
    ],
    "proof_obligations": [
      "rule-one-import-creates-at-most-fifty-skills",
      "rule-one-import-admits-a-name-once",
      "rule-a-name-from-another-source-is-not-versioned",
