  "ownership_decision": {
    "owner_context": "registry",
    "invariant": "Only registry decides whether an operator's takedown or restriction may land on a skill; a deleted skill that has not been purged is still a skill an operator can hold.",
    "evidence": [
      "apps/platform/internal/skill/library/takedown.go:16-20",
      "apps/platform/internal/skill/library/restriction.go:24-28",
      "db/queries/skills.sql:121-127"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/skill/library/takedown.go:16-20",
      "apps/platform/internal/skill/library/restriction.go:24-28",
      "db/queries/skills.sql:121-127"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A skill its owner deleted before a complaint arrived could not be taken down or restricted, because the operator search and the operator lock skipped deleted skills, so the content was purged once the grace period ended."
    ],
    "decision": "The operator search lists deleted skills that have not been purged, with deleted_at; takedown and restriction lock the skill whether or not its owner deleted it. Curation and redistribution still refuse a deleted skill.",
    "invariants_preserved": [
      "A deleted skill held by an operator never returns to the owner's list or to search.",
      "Curation and redistribution verdicts are refused on a deleted skill."
    ],
    "rejected_alternatives": [
      "Treating a delete as a withdrawal and recording only that the owner deleted it: once grace ends nothing is left to review."
    ],
    "proof_obligations": [
      "rule-a-held-skill-is-not-purged"
    ],
    "counterfactual_check": "Locking a deleted skill with the write loader in SetTakedown fails TestAnOperatorCanHoldASkillItsOwnerDeletedFirst with a 404."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-held-skill-is-not-purged",
        "statement": "A purge keeps the row of a skill that has test cases or a version referenced by a run, a download or a bundle; the deleted-skill sweep also keeps a skill while its publication is unretired or retired less than the ninety-day name hold ago, and while an operator takedown or access restriction is in force on it. An operator can take down or restrict a skill its owner has deleted until the sweep purges it, and the operator's skill search lists such a skill with when it was deleted.",
        "contexts": [
          "registry"
        ],
        "examples": [
          "A deleted skill past grace that has test cases survives the sweep.",
          "A deleted skill whose publication retired 89 days 23 hours ago survives the sweep; at 90 days and a minute it is purged.",
          "A skill its owner deleted while an operator takedown was in force survives the sweep past grace; after the operator lifts the takedown the next sweep purges it.",
          "A skill its owner deleted before any complaint is found by the operator's search, taken down or restricted, and then survives the sweep past grace; a deleted skill nobody holds is purged."
        ],
