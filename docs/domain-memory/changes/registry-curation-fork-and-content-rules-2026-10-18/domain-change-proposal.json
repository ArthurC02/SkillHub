  "implementation_design": {
    "domain_forces": [
      "A second extraction of the registry Context found enforced rules beyond the seven the Registry held, four of them guarded by no test."
    ],
    "decision": "Record the rules as reviewed citing code and test; add the missing tests; no product code change.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Recording the service-level licence claim completeness check: the aggregate repeats it, so weakening one alone is equivalent."
    ],
