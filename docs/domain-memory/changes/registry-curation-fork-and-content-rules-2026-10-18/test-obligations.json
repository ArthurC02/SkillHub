      "status": "planned",
      "check": "go test -count=1 -v -run ^TestValidRestrictionNoteAcceptsExactlyTheByteCap$ ./internal/skill/library/governance/"
    },
    {
      "id": "rule-an-operator-note-is-counted-in-characters",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-an-operator-note-is-counted-in-characters",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "an-operator-note-is-counted-in-characters"
        }
      ],
      "expected_outcome": "The operator note cap counts characters, not bytes, so a note of Chinese characters up to the cap is accepted.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestARestrictionNoteIsCountedInCharacters$ ./internal/skill/library/governance/"
    },
    {
      "id": "rule-a-restriction-reason-must-be-known",
