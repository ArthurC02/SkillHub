        }
      ],
      "expected_outcome": "Restricting a skill with a reason code outside the known set is refused, listing the known codes.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestRestrictionServiceRejectsInvalidInputBeforeDatabase$ ./internal/skill/library/governance/"
    },
    {
      "id": "rule-a-taken-down-skills-package-is-not-current",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-taken-down-skills-package-is-not-current",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-taken-down-skills-package-is-not-current"
        }
      ],
      "expected_outcome": "A taken-down skill's package is never reported as current content.",
      "level": "integration",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestAPackageOfATakenDownSkillIsNotCurrent$ ./internal/skill/library/"
    },
    {
      "id": "rule-a-diff-refuses-a-version-of-another-skill",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-diff-refuses-a-version-of-another-skill",
      "also_covers": [
        {
          "source_type": "rule",
