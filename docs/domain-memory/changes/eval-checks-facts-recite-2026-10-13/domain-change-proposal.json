  "ownership_decision": {
    "owner_context": "eval",
    "invariant": "eval reads a run only through the facts its ports return, and writes its trace events in the evaluation's own transaction.",
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/trial.go:99",
      "apps/platform/internal/trial/improvement/eval.go:405"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: run's evaluation facts reach eval through the composition root; eval records its trace events synchronously.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/trial.go:99"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "The check engine and the evaluation input were declared inside eval, so they could not be separated from the evaluation pipeline."
    ],
    "decision": "Move the check engine to trial/improvement/checks and the facts eval reads to trial/improvement/facts, both inside the eval Context; re-cite the two records whose cited lines changed (eval.RunFacts became facts.Run, m.run became m.Run).",
    "invariants_preserved": [
      "Each record states the same fact as before.",
      "Run facts reach eval unchanged, field for field."
    ],
    "rejected_alternatives": [
      "Putting the facts in checks: wiring's ports would return checks.RunFacts, naming an input after one of its readers."
    ],
    "proof_obligations": [
      "run-facts-reach-eval",
      "evaluation-trace-written"
    ],
    "counterfactual_check": "Drop Succeeded from evalRunFacts; TestEvaluationReceivesTheOwnersTerminalVerdict must fail."
  },
