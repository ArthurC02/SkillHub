  "implementation_design": {
    "domain_forces": [
      "A second extraction of the eval Context found enforced rules beyond the nine the Registry held, several guarded by no test."
    ],
    "decision": "Record the rules as reviewed citing code and test; add the missing tests; no product code change.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Recording the unchanged-content guard in check(): the later empty-diff guard blocks with the same reason, so its mutation is equivalent.",
      "Recording the met-run gate before the suggester call: a met verdict has every criterion passed, so with only informational findings the digest has nothing to cite and the zero-evidence gate already stops the call; weakening the gate alone changes nothing."
    ],
    "proof_obligations": [
      "rule-at-most-ten-suggestions-are-stored-per-evaluation",
      "rule-no-model-call-without-citable-evidence",
      "rule-a-quote-under-twelve-runes-cannot-be-suggestion-evidence",
