      "rule-info-findings-are-kept-out-of-the-suggestion-digest",
      "rule-a-repeated-suggestion-id-in-an-apply-counts-once",
      "rule-every-applied-suggestion-must-be-accepted",
      "rule-a-suggestion-of-another-evaluation-cannot-be-applied-through-this-one",
      "rule-suggestions-apply-only-through-their-evaluated-skill",
