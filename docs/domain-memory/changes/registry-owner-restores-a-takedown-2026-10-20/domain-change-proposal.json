  "implementation_design": {
    "domain_forces": [
      "An owner's own takedown could not be undone by anyone, so one slip cost the Skill its version history."
    ],
    "decision": "Record who took a Skill down; the owner restores their own within 30 days and an operator lifts any, writing the search document back pending enrichment.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Letting the owner undo an operator's takedown: it would undo an abuse or licensing decision the owner is the subject of."
    ],
    "proof_obligations": [
      "rule-an-owner-restores-only-their-own-takedown-within-thirty-days"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "an-owner-restores-only-their-own-takedown-within-thirty-days",
        "statement": "The owner may undo a takedown the owner made, within 30 days of it; a takedown an operator made, or one whose origin is unknown, only an operator lifts, at any time; restoring a Skill that is not taken down is refused.",
        "contexts": [
          "registry"
        ],
        "examples": [
          "An owner's takedown exactly 30 days old is restored; 30 days and a second is refused; an operator's takedown an hour old is refused to the owner and lifted by an operator."
        ],
