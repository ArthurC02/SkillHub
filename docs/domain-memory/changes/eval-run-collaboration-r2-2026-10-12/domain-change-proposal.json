  "ownership_decision": {
    "owner_context": "run",
    "invariant": "One origin key in a Workspace starts at most one Run; asking again returns that Run, and asking with another Skill Version is refused.",
    "evidence": [
      "docs/adr/ADR-009-evaluation-verdicts-and-judge-trust.md:104",
      "apps/platform/internal/trial/execution/service.go:909"
    ]
  },
  "boundary_decision": {
    "interaction": "run provides eval a trial port (start with an origin key, continue with the simulated-answer flag, chain ends, confirmed permission hash) and run facts for judging; eval provides run the verdicts its run list shows. run never hands its transaction to eval.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "eval writing inside run's transaction"
    ],
    "evidence": [
      "docs/adr/ADR-009-evaluation-verdicts-and-judge-trust.md:104",
      "apps/platform/internal/entrypoint/wiring/evaluation_batches.go:28"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A batch advance can crash between starting a run and recording it, and two advances can claim the same trial because the claim holds no lock.",
      "A trial must never be charged twice."
    ],
    "decision": "run owns an origin key, unique per Workspace and looked up before admission; eval records the trial in its own statement after it has the run.",
    "invariants_preserved": [
      "Run state stays owned by run's state machine.",
      "A replay is not refused by the concurrency slot its own run holds."
    ],
    "rejected_alternatives": [
      "Keep the transaction callback: it lets eval write inside run's transaction and was the only guard against double starts.",
      "Hold the claim lock across the run start: couples eval's row lock to run's admission and capacity transaction."
    ],
    "proof_obligations": [
      "origin-key-replay-returns-the-run",
      "passing-refusals-published"
    ],
    "counterfactual_check": "Move the origin-key lookup after admission; the replay test must fail because the concurrency slot refuses the run's own replay."
  },
