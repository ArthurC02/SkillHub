  "implementation_design": {
    "domain_forces": [
      "A second extraction of the policy Context found how the allowance counts and resets, which the Registry did not hold.",
      "The order of the two refusal reasons survived its counterfactual; a test was added."
    ],
    "decision": "Record the rules as reviewed citing code and test; no product code change.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Recording guards no test reaches: they wait for a test.",
      "Recording that only the asking Workspace's runs are counted: dropping the Workspace id zeroes every count, so no test isolates the cross-Workspace case."
    ],
    "proof_obligations": [
      "rule-the-daily-allowance-counts-the-last-24-hours",
