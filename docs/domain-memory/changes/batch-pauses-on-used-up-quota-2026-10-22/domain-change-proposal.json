    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "batch-waits-only-on-a-passing-refusal",
        "statement": "An evaluation batch waits when Run refuses a trial with a refusal Run says will pass on its own, including a run quota that could not be counted; pauses with the reason recorded when the refusal is one the owner can outwait or fix, a credit top-up or a used-up daily or windowed run quota; and stops with the reason recorded on any other refusal.",
        "contexts": [
          "batch"
        ],
        "examples": [
          "A credit_balance refusal pauses the batch with only its first trial run; a missing permission confirmation stops it.",
          "A quota_daily or quota_window refusal pauses the batch; a quota_unavailable refusal makes it wait."
        ],
