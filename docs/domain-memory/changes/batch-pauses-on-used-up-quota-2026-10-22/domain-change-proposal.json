  "ownership_decision": {
    "owner_context": "batch",
    "invariant": "Only batch decides whether a refused trial makes the batch wait, pause or stop; Run only classifies its refusal.",
    "evidence": [
      "apps/platform/internal/trial/batch/batch.go:277-282"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: Run's batch facts classify a refusal and wiring maps it to batch's RunRefusedError.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/trial/execution/batch_facts.go:40-51"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A batch stopped for good on a used-up run quota, although the quota resets on its own and the contract keeps stopped for refusals neither waiting nor a top-up fixes; a single failure to count the quota stopped it too."
    ],
    "decision": "Classify an exhausted run quota as pausing and an uncounted one as passing, by the entitlement sentinels the refusal wraps.",
    "invariants_preserved": [
      "A batch paused for thirty days stops.",
      "A batch whose test case is gone stops."
    ],
    "rejected_alternatives": [
      "Waiting on an exhausted quota: a windowed quota can stay exhausted for weeks while the batch retries every tick."
    ],
    "proof_obligations": [
      "rule-batch-waits-only-on-a-passing-refusal",
      "rule-a-batch-whose-test-case-is-gone-stops"
    ],
    "counterfactual_check": "Dropping the quota sentinel from RefusalPausesBatch fails the pause table; dropping it from RefusalPasses fails the passing table."
  },
