      "apps/platform/internal/trial/design/testlab.go:640-642"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A Test Case could hold fifty criteria while the judge reads twenty and marks the whole evaluation truncated past that, so a Test Case with more than twenty criteria could never pass and the author could not see why."
    ],
    "decision": "Lower the Test Case cap to the judge's twenty and put both on the same one-number roster so they cannot drift; existing Test Cases over the cap keep their criteria and the editor says only the first twenty are judged.",
    "invariants_preserved": [
      "A refused criterion leaves the Test Case unchanged.",
      "Existing criteria are never deleted by a limit change."
    ],
    "rejected_alternatives": [
      "Judging in batches of twenty and merging: the judge cost multiplies with the number of criteria, and atomic criteria are the better practice."
    ],
    "proof_obligations": [
      "rule-a-test-case-holds-at-most-50-criteria"
    ],
    "counterfactual_check": "Raising MaxCriteria back to fifty fails TestAddCriterionAcceptsUpToTheLimitAndRefusesOneOver."
  },
  "event_change": null,
  "contract_change": null,
