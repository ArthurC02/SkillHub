  "ownership_decision": {
    "owner_context": "testlab",
    "invariant": "Only testlab decides how many criteria a Test Case may hold; the judge's batch size is the same marked number.",
    "evidence": [
      "apps/platform/internal/trial/design/testlab.go:43-43",
      "apps/platform/internal/trial/design/testlab.go:640-642"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
