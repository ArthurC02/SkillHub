  "ownership_decision": {
    "owner_context": "batch",
    "invariant": "Only the batch Context writes evaluation_batches and evaluation_batch_items; eval writes none of them.",
    "evidence": [
      "docs/adr/ADR-009-evaluation-verdicts-and-judge-trust.md:104",
      "apps/platform/internal/trial/batch/doc.go:1"
    ]
  },
  "boundary_decision": {
    "interaction": "batch consumes run's trial port, testlab's snapshot facts, trace's question count and eval's standing verdicts through composition-root ports; it imports only identity.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "batch importing eval, run, testlab or trace",
      "eval reading or writing evaluation batch tables"
    ],
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/evaluation_batches.go:23"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "eval had grown to 42 files mixing one-Run judgement with many-trial measurement.",
      "The batch report read evaluation rows directly, so eval's storage was a second contract."
    ],
    "decision": "Move the batch code, its event consumer and job arguments into trial/batch; eval exposes StandingVerdicts and the composition root translates it into the batch's Verdict.",
    "invariants_preserved": [
      "The River job kind advance_evaluation_batches is unchanged, so queued jobs still run.",
      "The public contract keys are unchanged."
    ],
    "rejected_alternatives": [
      "A batch subpackage inside eval: keeps two owners of one package boundary and hides the dependency from depguard."
    ],
    "proof_obligations": [
      "report-uses-verdict-port",
      "batch-suite-passes",
      "boundaries-enforced"
    ],
    "counterfactual_check": "Make the verdict port report every run as not judged; the batch report test must fail."
  },
