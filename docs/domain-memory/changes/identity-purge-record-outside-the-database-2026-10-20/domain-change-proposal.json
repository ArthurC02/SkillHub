  "implementation_design": {
    "domain_forces": [
      "Purge and its audit event live in the database, so restoring a backup taken before a purge brings the erased account back."
    ],
    "decision": "Record every purge in object storage before it removes anything, and replay that record before a restored database takes traffic and daily after.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Recording the purge in the database: a restore would roll the record back with the account.",
      "Asking the operator to remember which accounts to purge again: detection must not depend on a person."
    ],
    "proof_obligations": [
      "rule-an-account-purge-is-recorded-outside-the-database-first",
      "rule-a-restored-account-is-purged-again-from-the-purge-record"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "an-account-purge-is-recorded-outside-the-database-first",
        "statement": "Once an account purge has claimed the account, it records the account in object storage, outside the database, before it removes any file or row; when that record cannot be written the purge stops and the account and its files stay as they were.",
        "contexts": [
          "identity"
        ],
        "examples": [
          "With the object store refusing writes, a sweep over an account due for purge reports the record failure, removes no object, and leaves the account undeleted."
        ],
        "evidence": [
          {
