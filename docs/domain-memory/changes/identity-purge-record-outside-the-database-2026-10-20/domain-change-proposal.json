    },
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-restored-account-is-purged-again-from-the-purge-record",
        "statement": "Replaying the purge record registers an erasure for, and purges at once, every recorded account the database holds alive; it leaves accounts already purged and accounts the database does not hold alone, and fails naming any record it cannot read or any account it could not purge.",
        "contexts": [
          "identity"
        ],
        "examples": [
          "After restoring a backup taken before Alice's purge, replay purges Alice again and only Alice; a second replay purges no one; a record named not-an-account makes the replay fail naming it."
        ],
