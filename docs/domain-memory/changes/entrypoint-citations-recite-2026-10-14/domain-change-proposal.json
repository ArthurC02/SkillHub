  "ownership_decision": {
    "owner_context": "registry",
    "invariant": "Operator governance decisions on a skill belong to registry; catalog only supplies their display strings through the composition root.",
    "evidence": [
      "apps/platform/internal/skill/library/governance/service.go:19-28"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: every re-cited interaction keeps its producer, consumer and delivery.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/api/apiserver/app.go:455-458"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "Adding the governance wiring shifted the composition root, and one single-line citation now matches two identical lines."
    ],
    "decision": "Re-cite the shifted interactions at their new lines and cite registry-packaging-skill-facts by its whole closure, whose text occurs once.",
    "invariants_preserved": [
      "Each interaction states the same fact as before.",
      "Every handler and owner read is still wired."
    ],
    "rejected_alternatives": [
      "Citing the single call line again: the same line also appears in the catalog reader, so the citation stays ambiguous."
    ],
    "proof_obligations": [
      "packaging-reads-owner-facts",
      "app-wiring-complete"
    ],
    "counterfactual_check": "Drop Registry from newGovernanceService; TestNewAppWiresEveryRouteAndService must fail."
  },
