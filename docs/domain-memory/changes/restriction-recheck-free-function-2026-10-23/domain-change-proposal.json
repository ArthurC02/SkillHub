      "asset": "rules",
      "record": {
        "id": "an-access-restricted-skill-never-reaches-a-sandbox",
        "statement": "A run of a skill under an access restriction is refused when it is created, and a run that was queued before the restriction was set fails as policy_refused at dispatch, before any sandbox receives the package; while the restriction cannot be read the run stays queued.",
        "contexts": [
          "run"
        ],
        "examples": [
          "A run queued before an operator sets license-review fails as policy_refused naming the license review, and the sandbox sees no dispatch; after the restriction is cleared a new run succeeds."
        ],
