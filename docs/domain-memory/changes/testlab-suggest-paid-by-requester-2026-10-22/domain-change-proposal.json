  "boundary_decision": {
    "interaction": "credit-testlab-spend: the composition root hands testlab a start check and a charge hook backed by credit, the same shape generation uses.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "testlab importing credit"
    ],
    "evidence": [
      "apps/platform/internal/trial/design/suggest.go:64-66",
      "apps/platform/internal/entrypoint/api/apiserver/credit_wiring.go:93-127"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "The suggestion route was the only user-started model call with neither the invitation gate nor a credit debit; its cost was recorded but never charged, so an account at zero credits could keep spending."
    ],
    "decision": "Gate the route on the invite list, check the owner's balance against the suggest_criteria start threshold before the model call, and charge the reported usage after it, through a hook the composition root wires to credit.",
    "invariants_preserved": [
      "A refused suggestion calls no model and charges nothing.",
      "A suggestion stores nothing on the test case."
    ],
    "rejected_alternatives": [
      "Reserving a per-call amount like a creation step: a suggestion is one short call, and the start threshold already bounds the overdraft at the debt floor."
    ],
    "proof_obligations": [
      "rule-a-criteria-suggestion-is-paid-for-by-its-requester"
    ],
    "counterfactual_check": "Skipping the start check before the model call fails TestSuggestingCriteriaBelowTheStartThresholdIsRefusedBeforeTheModelIsCalled."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-criteria-suggestion-is-paid-for-by-its-requester",
        "statement": "Suggesting acceptance criteria is a model call the user starts, so it is open only to invited accounts, refused before the model is called when the owner's credit balance is below the start threshold for suggest_criteria, and debited by the usage the gateway reported once the model answers.",
        "contexts": [
          "testlab"
        ],
        "examples": [
          "With no suggest_criteria statistics the threshold is the 70-credit fallback: a balance of 69 is refused with no model call and nothing charged; a balance of 70 is allowed and a $0.01 answer debits 13 credits at the default markup."
        ],
