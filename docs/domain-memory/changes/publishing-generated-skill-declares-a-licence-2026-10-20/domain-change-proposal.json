      "record": {
        "id": "only-a-generated-skill-declares-a-licence-on-its-release",
        "statement": "An author may declare a licence when releasing a Skill only if the Skill was generated for them, and only one of the known SPDX identifiers, spelled exactly; the declaration is kept on that release.",
        "contexts": [
          "publishing"
        ],
        "examples": [
          "Releasing a generated Skill with MIT stores MIT on the release; WTFPL, mit, or MIT on a self-supplied Skill is refused as license_not_declarable."
        ],
