  "implementation_design": {
    "domain_forces": [
      "A generated Skill could never be exposed: its redistribution cannot be changed from generated, while the screens told operators to judge it allowed first."
    ],
    "decision": "Let the author declare a licence from a fixed SPDX list on the release of a generated Skill; a generated Skill whose latest release declares one is cleared for the Catalog.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Letting operators change generated to allowed: the operator cannot vouch for content only the author asked for.",
      "Recording the declaration on the Skill: a later release could then inherit a licence its author never chose for it."
    ],
    "proof_obligations": [
      "rule-only-a-generated-skill-declares-a-licence-on-its-release",
      "rule-catalog-exposure-needs-an-approved-review-of-redistributable-content",
      "rule-an-exposure-approval-needs-a-current-enriched-snapshot",
      "rule-republishing-the-same-version-keeps-its-one-release"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
