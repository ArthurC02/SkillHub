      "record": {
        "id": "catalog-exposure-needs-an-approved-review-of-redistributable-content",
        "statement": "A publication is exposed in the Catalog only when its review is approved, its Skill is available and cleared for the Catalog, and its search snapshot is listable, of the released version and with the digest the reviewer approved. A Skill is cleared for the Catalog when its redistribution is allowed, or when it was generated and its latest release declares a licence.",
        "contexts": [
          "publishing"
        ],
        "examples": [
          "An approved Skill whose content its creator supplied is not exposed, even with a licence on its release; an approved generated Skill is exposed once its latest release declares MIT."
        ],
