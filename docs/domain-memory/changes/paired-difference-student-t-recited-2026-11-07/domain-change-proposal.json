    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-paired-difference-is-called-better-only-when-its-interval-excludes-zero",
        "statement": "A paired difference between two batches, or between a batch and its skill-withheld arm, is presented as better or worse only when its interval excludes zero: improved or worse when the 99.9% interval does, likely improved or likely worse when only the 95% interval does, no clear difference when the 95% interval includes zero, and too few pairs below two pairs; nothing short of likely improved is presented as an improvement.",
        "contexts": [
          "batch"
        ],
        "examples": [
          "A mean of +0.19 with a standard error of 0.1 has a 95% interval that includes zero, so the comparison says there is no clear difference rather than better.",
          "A mean of +0.2 with a standard error of 0.1 is likely improved; +0.33 is improved.",
          "One paired test case gives a difference but too few pairs for a verdict."
        ],
        "evidence": [
          {
