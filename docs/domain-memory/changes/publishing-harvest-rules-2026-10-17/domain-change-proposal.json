  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the publishing Context found eight enforced rules; the reviewed Registry held none, so the next Agent could not look them up.",
      "Refusing a version that fails validation had no test anywhere."
    ],
    "decision": "Record the eight rules as reviewed citing code and test; add the integration test for the validation refusal.",
    "invariants_preserved": [
      "A publication name never changes once published."
    ],
    "rejected_alternatives": [
      "Recording the stale-review guard: its test proves only sameReleaseAs, not the refusal path, so it waits for a test of its own."
    ],
    "proof_obligations": [
      "rule-the-release-gate-refuses-unclear-or-blocked-redistribution",
      "rule-a-publication-name-is-permanent",
      "rule-a-publisher-name-refuses-reserved-words",
      "rule-releasing-requires-a-registered-publisher",
      "rule-a-version-failing-validation-cannot-be-published",
      "rule-public-availability-reports-the-first-reason-it-is-withheld",
      "rule-catalog-exposure-needs-an-approved-review-of-redistributable-content",
      "rule-an-exposure-approval-needs-a-current-enriched-snapshot"
    ],
    "counterfactual_check": "Break each rule's enforcing line so the package still builds; its test must fail with that rule's own assertion."
  },
