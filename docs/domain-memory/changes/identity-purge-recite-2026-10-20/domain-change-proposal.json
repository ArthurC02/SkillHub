      "record": {
        "id": "purge-waits-for-grace-and-quiet-workspace",
        "statement": "An account purge starts only when the deletion request is older than the 30-day grace at the moment of claiming and every Run in each of the Account's workspaces has finished cleanup; otherwise the purge is deferred (not failed) and retried by a later sweep.",
        "contexts": [
          "identity"
        ],
        "examples": [
          "A request made now is not claimed by a sweep whose cutoff is 30 days ago; the Account does not start purging.",
          "An Account with a Run still cleaning up its sandbox is skipped this sweep without an error."
        ],
