      "record": {
        "id": "purge-removes-files-before-rows",
        "statement": "An account's stored files are removed before its database rows are erased, and the rows are erased in one transaction, so a failure leaves rows pointing at missing files that the next sweep can finish, never a file that no row names.",
        "contexts": [
          "identity"
        ],
        "examples": [
          "If the object store fails mid-purge, the account stays claimed and the next sweep retries the deletion."
        ],
