  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "an-operator-erasure-skips-the-deletion-grace",
        "statement": "An operator may register an erasure for an account on its holder's behalf, with a reason; it requests deletion if none is pending, keeps an earlier request time, and lets the next purge sweep take the account without waiting out the 30-day grace. The holder cancelling the deletion withdraws it, and an account already purging or deleted refuses it.",
        "contexts": [
          "identity"
        ],
        "examples": [
          "An account erased by an operator today is purged by today's sweep, while one deleted by its owner today waits; erasing a purged account answers 409."
        ],
