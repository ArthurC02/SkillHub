  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "eval",
    "invariant": "A batch reflection is immutable once recorded, reads only failing runs of its development cases, needs at least one held-out case and settled development trials, and its suggestions belong to it alone: exactly one of evaluation_id and reflection_id is set on a suggestion, and the version it was written against is the batch version, held equal by a composite foreign key.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "batch provides the batch skill, version, status and per-case trial settlement through a composition-root fact reader (batch-eval-batch-trials); eval imports nothing from batch. The applied version reaches ingest through the existing improved_by provenance, now carrying reflection_id.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "eval must not import batch"
    ],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "Suggestions read from the same cases they are checked on overfit; a held-out set is what makes the rerun evidence.",
      "The round reads one version, so its suggestions apply to that version only.",
      "A suggestion has one owner, so a run evaluation list never shows a round suggestion.",
      "The user starts the model call, so they pay for it, as with run suggestions.",
      "The eval Service is held at its method and field budget."
    ],
    "decision": "A reflection subpackage of eval orchestrates the round and owns its HTTP, reading batch facts through an injected port; eval exports package functions to read a run failure, store a round and list rounds, and holds the Reflection aggregate that reuses the suggestion ledger for decide and apply. batch_reflections stores skill_version_id under a composite foreign key to evaluation_batches, so apply needs no batch reader.",
    "invariants_preserved": [
      "Run suggestions keep their own owner, events and apply path.",
      "Skill versions stay immutable; applying builds a new version.",
      "Model calls go through the gateway via apps/llm; Go decides admission, debit and refusal."
    ],
    "rejected_alternatives": [
      "Storing no version on the round and reading it from the batch, which put a batch reader on the eval Service.",
      "Writing round suggestions under a synthetic evaluation, which would show them in a run suggestion list.",
      "Updating the round outcome after its suggestions are stored, which the immutable table forbids; the outcome is decided before the insert."
    ],
    "proof_obligations": [
      "rule-a-batch-reflection-reads-only-its-development-cases",
      "eight-runs-read",
      "only-development-runs-reach-the-model",
      "holds-a-case-out",
      "waits-for-development-trials",
      "rule-a-batch-reflection-is-paid-for-by-its-requester",
      "applies-through-the-existing-path"
    ],
    "counterfactual_check": "Let devTrials accept a development set that names every case; the decision-table test must fail. Skip the billing admission in reflect; the below-threshold test must fail because the model is called."
  },
