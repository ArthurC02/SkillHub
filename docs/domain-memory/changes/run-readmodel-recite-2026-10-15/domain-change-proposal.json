  "ownership_decision": {
    "owner_context": "run",
    "invariant": "A Run's recorded state is answered only by run; the read model sits inside run and never changes a Run.",
    "evidence": [
      "apps/platform/internal/trial/execution/readmodel/read.go:17-21"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: every re-cited record keeps its producer, consumer and delivery; run now answers through readmodel.Reader.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/trial.go:105-129"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "run's Service carried 138 methods, nine of them pure reads other Contexts ask through the composition root."
    ],
    "decision": "Move the pure reads (trace, evaluation, workspace membership, continuation chain ends) into trial/execution/readmodel as methods on a Reader value built from the run pool; reads that need Service hooks stay in run.",
    "invariants_preserved": [
      "Each record states the same fact as before.",
      "The read model reuses run.IsTerminal, so the terminal verdict has one source."
    ],
    "rejected_alternatives": [
      "Keeping thin delegators on run.Service: the method count would not fall and two entry points would answer the same question."
    ],
    "proof_obligations": [
      "readmodel-terminal-verdict",
      "eval-receives-terminal-verdict"
    ],
    "counterfactual_check": "Replace run.IsTerminal in readmodel.evaluationRun with a succeeded-only check; TestEvaluationRunCarriesTheTerminalVerdict must fail."
  },
