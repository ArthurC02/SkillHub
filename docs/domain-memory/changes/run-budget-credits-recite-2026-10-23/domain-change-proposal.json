      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-run-starts-only-when-its-budget-is-reserved",
        "statement": "When a credit ledger is configured, a Run is admitted only if the Workspace can reserve the run budget in force when it is created: the operator-set ceiling, or the deployment's when none is set. The Run keeps that ceiling in its policy snapshot, and its attempts run under it whatever the setting becomes later; a Workspace that cannot reserve it is refused with credit_balance.",
        "owner": "run-execution",
        "version": "unknown",
        "effective_from": "unknown",
        "effective_until": "unknown",
        "contexts": [
          "run"
        ],
        "examples": [
          "A Workspace with 100 credits is refused with credit_balance under a 0.50 USD ceiling and admitted once the operator lowers it to 0.05 USD.",
          "A Run created under a 0.05 USD ceiling issues its first gateway key at 0.05 USD after the operator raises the ceiling to 2 USD.",
          "A deployment with no credit ledger admits the Run without a reservation."
        ],
