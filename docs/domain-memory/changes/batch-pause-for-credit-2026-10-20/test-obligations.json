      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-batch-paused-for-thirty-days-stops"
        }
      ],
      "expected_outcome": "A batch paused for 30 days stops with reason paused_too_long; one paused for less stays paused and can be resumed from its next unrun trial.",
