  "implementation_design": {
    "domain_forces": [
      "A batch that ran out of credit stopped for good, so a top-up meant running and paying for its finished trials again."
    ],
    "decision": "Pause on a refusal that awaits a top-up; resume from the next unrun trial; stop after 30 days paused.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Waiting on a credit refusal like a passing one: the batch would retry every minute with no end."
    ],
    "proof_obligations": [
      "rule-batch-waits-only-on-a-passing-refusal",
      "rule-a-batch-paused-for-thirty-days-stops"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
