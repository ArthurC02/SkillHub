  "implementation_design": {
    "domain_forces": [
      "Enrichment on import and the enrichment backfill called the model during a P1 halt, the one situation in which every model call a person or the platform starts is meant to stop."
    ],
    "decision": "Under a P1 halt an import skips enrichment and leaves it pending, and the backfill returns without picking anything up; once the halt is lifted the backfill enriches the pending versions as usual.",
    "invariants_preserved": [
      "An import never fails because enrichment was skipped.",
      "An unreadable halt state counts as halted."
    ],
    "rejected_alternatives": [
      "Refusing the import under a halt: the import calls no model unless it enriches, so only the enrichment step stops."
    ],
    "proof_obligations": [
      "rule-user-started-model-calls-stop-under-a-p1-halt"
    ],
    "counterfactual_check": "Removing the halt check from enrichment fails TestAnImportUnderAP1HaltLeavesEnrichmentPendingWithoutCallingTheModel; removing it from ReindexPending fails TestTheEnrichmentBackfillWaitsOutAP1Halt."
  },
