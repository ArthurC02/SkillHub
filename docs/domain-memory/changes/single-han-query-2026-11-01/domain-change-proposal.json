  "implementation_design": {
    "domain_forces": [
      "One Han character is a complete word a searcher types on purpose.",
      "One Latin letter, digit, kana or symbol matches too much to be a useful search."
    ],
    "decision": "isComprehensible accepts a single rune when unicode.Is(unicode.Han, r); every other query still needs two runes and a letter or digit.",
    "invariants_preserved": [
      "Invalid UTF-8 and control characters are never searched.",
      "A query without a letter or digit is never searched."
    ],
    "rejected_alternatives": [
      "A hard-coded U+4E00-9FFF range, which misses the extension blocks.",
      "Accepting any single letter, which would search one Latin letter."
    ],
    "proof_obligations": [
      "rule-a-searchable-query-has-two-runes-and-a-letter-or-digit"
    ],
    "counterfactual_check": "Dropping the unicode.Han clause makes TestIsComprehensible fail on 你, 表 and 𠮟."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-searchable-query-has-two-runes-and-a-letter-or-digit",
        "statement": "A query is searched only when it is valid text without control characters and holds a letter or digit, and it has at least two characters unless it is one Han character.",
        "contexts": [
          "catalog"
        ],
        "examples": [
          "'R', '1', 'ア' and '!!' are not searched; '表', '𠮟', 'C#' and '轉表格' are."
