  "implementation_design": {
    "domain_forces": [
      "A Run whose spend was unreadable at cleanup was never read again, so the late-settlement path existed but nothing reached it."
    ],
    "decision": "Record when a Run's cost is settled at its real spend; supervision re-queues unsettled cleaned Runs for a day.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Settling before revoking the key: the key could still spend after the read.",
      "Charging the reservation when unreadable: unreadable spend is the platform's fault, not the user's."
    ],
    "proof_obligations": [
      "rule-a-run-whose-spend-was-unreadable-is-read-again-for-a-day"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-run-whose-spend-was-unreadable-is-read-again-for-a-day",
        "statement": "A cleaned Run whose cost was not settled at its real spend is queued for another cleanup by supervision, at most once every 5 minutes, until a read settles it or a day has passed since it finished; a settled Run is never queued for spend again.",
        "contexts": [
          "run"
        ],
        "examples": [
          "A Run whose spend was unreadable at cleanup and finished 23 h 59 min ago is queued; one that finished 24 h 1 min ago is not; once the spend reads $0.0382 it is charged 50 credits and no longer queued."
        ],
