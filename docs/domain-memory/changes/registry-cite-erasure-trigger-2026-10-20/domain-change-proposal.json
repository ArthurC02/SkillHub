  "implementation_design": {
    "domain_forces": [
      "Iron rule 4 keeps every version a Run used, so an account purge kept the whole private skill whenever the owner had ever run it, against the promise that deleting the account deletes its content."
    ],
    "decision": "Erase content but keep version rows: an account purge tombstones skills only the workspace itself holds; the version trigger allows one content erasure.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Deleting the owner's Runs too: breaks iron rule 4, the consent's permanent Run metadata, and the credit records that point at Runs.",
      "Keeping the content: deleting an account would not delete what the user wrote."
    ],
    "proof_obligations": [
      "rule-a-skill-version-changes-only-once-to-erase-its-content"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-skill-version-changes-only-once-to-erase-its-content",
        "statement": "A skill version row never changes except once, to erase its content: that one update sets content_erased_at and must leave the manifest empty and the import source cleared, may change nothing else, and freezes the row again.",
        "contexts": [
          "registry"
        ],
        "examples": [
          "Erasing while rewriting the content hash, or while keeping the manifest, is refused; after the erasure, restoring a manifest, un-erasing or erasing again is refused."
        ],
