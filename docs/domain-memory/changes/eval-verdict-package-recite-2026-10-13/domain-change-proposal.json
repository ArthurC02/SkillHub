  "implementation_design": {
    "domain_forces": [
      "eval's value objects (criterion results, findings, evidence references, the overall verdict) were declared beside the evaluation pipeline, so the check engine and the judge could only live in the same package."
    ],
    "decision": "Move the value objects into the leaf subpackage trial/improvement/verdict inside the eval Context; StandingVerdict now names verdict.Overall; re-cite the contract's two verdicts.go citations.",
    "invariants_preserved": [
      "The contract states the same fact as before.",
      "The stored and served JSON of criterion results, findings and evidence references is byte-identical."
    ],
    "rejected_alternatives": [
      "Type aliases in eval for the moved types: two names for one concept, which the vocabulary check exists to prevent."
    ],
    "proof_obligations": [
      "standing-verdicts"
    ],
    "counterfactual_check": "Make verdictOf label a not-met evaluation with the met value; TestEveryVerdictTheDatabaseAllowsHasItsOwnSentence must fail."
  },
