    "invariant": "Every user-data query resolves its Workspace scope through identity.",
    "evidence": [
      "apps/platform/internal/creator/workspace/doc.go:1"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged in substance: the same collaborations stay permitted and the same ones stay forbidden. What changes is where the permission is recorded and what it takes to add one.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "creation",
      "entrypoint/worker",
      "entrypoint/wiring",
      "apiserver",
      "objreconcile"
    ],
    "evidence": [
      "docs/adr/ADR-016-platform-bounded-contexts-and-context-map.md:42"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "Which Context may call which is a domain decision, but it lived in a Markdown table that any edit could widen.",
      "The table granted every Context access to identity through a row with a blank left-hand side; a blanket grant is a hole in the rule that unlisted means denied.",
      "Recording the same permission in two places would drift, so the check must read the one place rather than reconcile two."
    ],
    "decision": "Record every permitted collaboration as a reviewed dependency policy, expand the blanket grant into one policy per Context, and let the machine check read them.",
    "invariants_preserved": [
      "Every user-data query resolves its Workspace scope through identity."
    ],
    "rejected_alternatives": [
      "Keep the whitelist in the document and cite it: the document is being deleted.",
      "Record only the forbidden collaborations: unlisted already means denied, so a forbidden record adds a second way to say the same thing.",
      "Keep the blanket grant as one record with no source: the schema requires two named Contexts, and for good reason."
    ],
    "proof_obligations": [
      "registry-structurally-valid",
      "cited-evidence-current",
      "the-whitelist-is-reproduced-exactly",
      "no-collaboration-rests-on-a-blank-source",
      "a-policy-names-two-known-contexts",
      "audit-chain-intact",
      "approval-path-is-external"
    ],
    "counterfactual_check": "a-policy-names-two-known-contexts"
  },
