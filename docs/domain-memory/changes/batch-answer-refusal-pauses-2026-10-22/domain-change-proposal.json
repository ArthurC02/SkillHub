  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "batch",
    "invariant": "Only batch decides whether a refused trial or answer pauses, stops or closes; run decides which refusals the owner can outwait or fix.",
    "evidence": [
      "apps/platform/internal/trial/batch/batch_simulated_user.go:61-85",
      "apps/platform/internal/entrypoint/wiring/evaluation_batches.go:94-112"
    ]
  },
  "boundary_decision": {
    "interaction": "run-batch-trials: unchanged; the answer port now returns the same RunRefusedError the start port does when the refusal pauses a batch.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/trial/batch/batch_simulated_user.go:61-85",
      "apps/platform/internal/entrypoint/wiring/evaluation_batches.go:94-112"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "A batch paused when a trial could not start for credit, but an answer refused for credit closed the trial as if the conversation had ended, so a top-up and resume could never give it; the report kept trials waiting for an answer forever."
    ],
    "decision": "Map a pausing refusal on the answer path to the same RunRefusedError, pause the batch from launched as well as launching, skip answering while paused, and let resume answer what is still owed.",
    "invariants_preserved": [
      "A trial that already ran is never run again.",
      "A batch paused for thirty days stops."
    ],
    "rejected_alternatives": [
      "Retrying the answer on every advance while paused: it would spend the owner's credit the moment it arrives, without the owner choosing to resume."
    ],
    "proof_obligations": [
      "rule-a-refused-simulated-answer-pauses-the-batch",
      "rule-a-batch-settles-only-when-no-trial-is-open"
    ],
    "counterfactual_check": "Letting the wiring close the trial on a pausing refusal fails TestASimulatedAnswerRefusedForCreditPausesTheBatchAndIsGivenAfterResume."
  },
  "event_change": null,
  "contract_change": null,
