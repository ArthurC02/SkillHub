  "rule_ids": [],
  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "run",
    "invariant": "A Go package under apps/platform/internal belongs to exactly one Bounded Context.",
    "evidence": [
      "apps/platform/architecture-identity.yaml:1"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged. This records what each Context is and where it lives; it opens no collaboration and closes none.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "docs/adr/ADR-016-platform-bounded-contexts-and-context-map.md:16"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "Eleven of the thirteen Bounded Contexts had no Registry record at all, so a reader asking the Registry which Context owns a package got silence rather than an answer.",
      "The subdomain, the implementation path and the requirement prefixes lived only in a Markdown table scheduled for deletion.",
      "A responsibility drifts from the code unless it is cited from the package that holds it."
    ],
    "decision": "Model all thirteen Contexts, each citing the machine identity file for its subdomain and path and its own package doc comment for its responsibility, and carry the requirement prefixes the table would otherwise take with it.",
    "invariants_preserved": [
      "A Go package under apps/platform/internal belongs to exactly one Bounded Context."
    ],
    "rejected_alternatives": [
      "Leave the eleven unmodelled until each is needed: the document that answers for them is being deleted, so that schedules the silence rather than preventing it.",
      "Keep the requirement prefixes in the identity file: they are which requirements a Context owns, which is domain knowledge, and only thirteen of the thirty-one identity rows have any.",
      "Cite the Context Map table for subdomain and path: that is the dependency being removed."
    ],
    "proof_obligations": [
      "registry-structurally-valid",
      "cited-evidence-current",
      "no-two-contexts-claim-one-path",
      "an-unknown-subdomain-is-refused",
      "no-citation-into-the-retired-map",
      "audit-chain-intact",
      "approval-path-is-external"
    ],
    "counterfactual_check": "no-two-contexts-claim-one-path"
  },
  "event_change": null,
  "contract_change": null,
