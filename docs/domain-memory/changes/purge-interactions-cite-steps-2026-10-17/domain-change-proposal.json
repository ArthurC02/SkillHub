  "ownership_decision": {
    "owner_context": "identity",
    "invariant": "Identity runs every owner's purge step in one transaction or none.",
    "evidence": [
      "apps/platform/internal/creator/workspace/purge.go:47-63"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: each owner provides its purge step through the composition root; identity lists the steps.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/api/apiserver/app.go:219",
      "apps/platform/internal/creator/workspace/purge.go:47-63"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "get-context eval did not reach identity's purge rule: the interaction cited only the wiring line, the rule only purge.go, so no shared file linked them."
    ],
    "decision": "Add to each of the nine owner purge interactions a citation of its own entry in purgeSteps; no code change.",
    "invariants_preserved": [
      "Account purge is all-or-nothing across owners."
    ],
    "rejected_alternatives": [
      "Citing the whole purgeSteps block from every interaction: one line per owner names exactly which step the interaction enrolls."
    ],
    "proof_obligations": [
      "evidence-current",
      "steps-wired"
    ],
    "counterfactual_check": "Remove one owner's entry from purgeSteps; the unwired-step test must fail naming that owner."
  },
