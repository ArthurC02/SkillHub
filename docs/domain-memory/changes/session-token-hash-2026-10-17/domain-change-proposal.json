  "implementation_design": {
    "domain_forces": [
      "A blind extraction of identity found the hashing; no test proved it, so storing the raw token would have stayed green."
    ],
    "decision": "Record the rule as reviewed and add the integration test that proves it; no product code change.",
    "invariants_preserved": [
      "A session resolves only while it has not expired and its account stands."
    ],
    "rejected_alternatives": [
      "Citing the migration column: db/migrations is outside the confirmed sources, and the bytea column alone does not say what is stored in it."
    ],
    "proof_obligations": [
      "session-stored-as-hash"
    ],
    "counterfactual_check": "Make hashToken return the raw token; the test must fail on the stored hash."
  },
