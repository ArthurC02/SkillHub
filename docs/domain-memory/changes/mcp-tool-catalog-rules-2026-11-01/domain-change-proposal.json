  "ownership_decision": {
    "owner_context": "ingest",
    "invariant": "Only an mcp_tools row that is not retired makes an mcp__<server>__<tool> name declarable in allowed-tools.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "Admission reads the unretired mcp_tools rows through the mcptools package; operators change them through the admin API",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "A Skill that names a tool the platform does not offer cannot use it in a trial run.",
      "An unreadable tool list must not read as a clean package."
    ],
    "decision": "Compare each mcp__ name against the unretired mcp_tools rows; block a created draft or version, warn an imported package, and fail the check when the list cannot be read.",
    "invariants_preserved": [
      "A retired row keeps its reason and frees its reference.",
      "At most one unretired row exists per server and tool."
    ],
    "rejected_alternatives": [
      "Blocking an imported package: the author of an outside package cannot be asked to edit it.",
      "Passing the package when the list is unreadable: it would admit names nobody checked."
    ],
    "proof_obligations": [
      "rule-a-skill-declares-only-mcp-tools-listed-in-mcp-tools",
      "rule-an-unlisted-mcp-tool-blocks-a-created-draft-and-warns-an-import",
      "rule-an-unreadable-mcp-tools-list-fails-the-admission-check",
      "rule-an-operator-lists-an-mcp-tool-once-with-a-reason-and-an-audit-event",
      "rule-retiring-an-mcp-tool-keeps-its-row-with-its-reason"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
