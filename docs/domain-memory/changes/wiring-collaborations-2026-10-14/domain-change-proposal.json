  "ownership_decision": {
    "owner_context": "identity",
    "invariant": "A Context reaches another Context only through behaviour the composition root hands it; each such hand-over is a reviewed interaction.",
    "evidence": [
      "tools/devctl/wiring_interactions.go:40",
      "apps/platform/internal/entrypoint/api/apiserver/app.go:210"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged code: 38 synchronous collaborations already wired through the composition root are recorded as interactions; the producer keeps its tables, the consumer receives a fact reader or hook.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/api/apiserver/app.go:210"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "wiring_edges held 39 collaborations the Registry did not know, so a reader of the Registry saw only 12 of the real cross-Context hand-overs."
    ],
    "decision": "Record each wired collaboration as an interaction (producer, consumer, synchronous, delivery) citing the wiring line; leave creation->trace in the baseline because its Masker is a string helper due to move out of trace.",
    "invariants_preserved": [
      "No code changes.",
      "No dependency policy changes, so the depguard deny lists are untouched."
    ],
    "rejected_alternatives": [
      "Recording them as allowed dependency policies: in this Registry an allowed policy also lifts the depguard deny entry, which would open Go imports these Contexts are meant not to have."
    ],
    "proof_obligations": [
      "wiring-registered",
      "guard-unchanged"
    ],
    "counterfactual_check": "Drop identity->run from wiring_edges while no interaction records it; TestTheCompositionRootWiresOnlyRegisteredCollaborations must fail naming identity->run at app.go:212."
  },
