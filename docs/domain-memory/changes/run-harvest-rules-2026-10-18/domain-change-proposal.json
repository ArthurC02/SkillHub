  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the run Context found these enforced rules; the reviewed Registry held nine others.",
      "The dispatch idempotency key had no test; one was added."
    ],
    "decision": "Record the rules as reviewed citing code and test; no product code change.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Recording guards no test reaches: they wait for a test.",
      "Recording the pre-dispatch cancellation check: the dispatch loop checks cancellation again before starting an attempt, so the mutation is equivalent and no test isolates it."
    ],
    "proof_obligations": [
      "rule-transient-provider-refusals-stop-at-the-attempt-ceiling",
