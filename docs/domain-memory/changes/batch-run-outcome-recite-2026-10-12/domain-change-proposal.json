  "ownership_decision": {
    "owner_context": "run",
    "invariant": "Only run decides what a run's status means; consumers read succeeded and failed, never the status text.",
    "evidence": [
      "apps/platform/internal/trial/execution/batch_facts.go:20"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: the batch reaches run, testlab, trace and eval through composition-root ports.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/entrypoint/wiring/evaluation_batches.go:45"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "eval and batch each spelled run statuses as their own string literals, so a renamed status would silently stop matching.",
      "The composition root invented the target_gone stop reason beside the batch's own creator_gone."
    ],
    "decision": "Run publishes Succeeded and Failed next to Terminal; the batch owns ErrTargetGone and its stop reason; re-cite the six records.",
    "invariants_preserved": [
      "Each record states the same fact as before.",
      "The stop reasons a client sees are unchanged."
    ],
    "rejected_alternatives": [
      "Exporting run's status enum to consumers: they may not import run, and a copy of the enum is the same duplication."
    ],
    "proof_obligations": [
      "trial-port-contract",
      "batch-waits-or-stops"
    ],
    "counterfactual_check": "Report every chain end as not failed; the gone-target test must read the failed trial as not evaluated and fail."
  },
