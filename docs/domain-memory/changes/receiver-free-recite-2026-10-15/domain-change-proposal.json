    "owner_context": "batch",
    "invariant": "A batch decides to wait or stop from the refusal run reports; stopping records the reason.",
    "evidence": [
      "apps/platform/internal/trial/batch/batch.go:259-267"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged: batch starts each trial through run and stops on a refusal waiting cannot fix.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "apps/platform/internal/trial/batch/batch.go:241-276"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "stopBatch never used its receiver, so it read as BatchService state it does not touch."
    ],
    "decision": "Make stopBatch, and the other unexported Service methods that ignore their receiver, plain functions; re-cite the two records whose cited lines call it.",
    "invariants_preserved": [
      "Each record states the same fact as before."
    ],
    "rejected_alternatives": [
      "Keeping the methods: a receiver-free method widens the Service and hides that the code needs none of its collaborators."
    ],
    "proof_obligations": [
      "refusal-stops-batch",
      "deleted-target-stops-batch"
    ],
    "counterfactual_check": "Alter the reason passed to stopBatch on a refusal; TestARefusalThatWaitingCannotFixStopsTheBatch must fail."
  },
