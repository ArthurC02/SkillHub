  "implementation_design": {
    "domain_forces": [
      "The model ports, the gateway adapter and the judge were declared inside eval, so the evaluation pipeline carried them all."
    ],
    "decision": "Move the model ports to trial/improvement/modelport, the gateway adapter to trial/improvement/llmadapter and the judge and panel to trial/improvement/judging, all inside the eval Context; re-cite eval-may-use-trace, whose cited lines only moved, and registry-run-facts-v1, whose version copy became runVersionFacts so a test can pin it.",
    "invariants_preserved": [
      "Each record states the same fact as before.",
      "Registry facts reach run field for field."
    ],
    "rejected_alternatives": [
      "Moving the adapter beside the ports in one package: eval tests build the adapter, and the adapter would import eval for the port types, an import cycle."
    ],
    "proof_obligations": [
      "registry-facts-reach-run",
      "evaluation-trace-written"
    ],
    "counterfactual_check": "Drop SourcePath from runVersionFacts; TestRunReceivesTheVersionFactsTheRegistryRecorded must fail."
  },
