      "record": {
        "id": "a-held-version-stays-outside-its-skills-line-until-promoted",
        "statement": "A version built only to evaluate a candidate of an improvement round is held: it takes its Skill's next version number and runs by its own id, but it is outside the Skill's line, so until it is promoted it is never the Skill's newest version, never describes the Skill, is never released, and is neither enriched nor written to the search index; every query that orders versions to find a newest, latest or previous one reads the line.",
        "contexts": [
          "registry",
          "ingest",
          "publishing"
        ],
        "examples": [
          "A Skill at v2 that holds two candidates as v3 and v4 still lists v2 as its newest, and a round started from v3's batch is refused with 409.",
          "Publishing a held v3 answers 422 held_for_evaluation.",
          "Holding two candidates makes no enrichment call and leaves the Skill's search document untouched."
        ],
