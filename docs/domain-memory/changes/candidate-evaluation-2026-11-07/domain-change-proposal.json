  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "eval",
    "invariant": "registry owns the Skill's line: held versions and their write-once promotions, read through skill_line_versions. eval owns the candidate evaluation of a round: one write-once record per candidate naming its held version and batch, and at most one write-once adoption of a built candidate.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "eval builds a held version through ingest's existing SaveImprovedVersion with HeldForEvaluation, and adopts by calling ingest's PromoteVersion before writing the adoption row; ingest promotes through the registry SkillRoot. The candidate-versions read takes the Skill's version ids from a registry port injected at the composition root. No new import between Contexts.",
    "consistency": "synchronous",
    "prohibited_dependencies": [
      "eval must not write skill_versions or skill_version_promotions",
      "registry must not read reflection tables"
    ],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "A candidate must run as a real, immutable version to be compared on the round's test cases.",
      "Until it is adopted a candidate must not become the Skill's face: newest, release, summary, search.",
      "Enrichment costs credits, so it is paid once, for the adopted candidate only.",
      "The adoption crosses two Contexts and cannot share one transaction."
    ],
    "decision": "skill_versions.held_for_evaluation marks a candidate's version; skill_line_versions is the line every newest read uses; promotion is a write-once row checked by a trigger and done by SkillRoot.Promote only on the round's base. eval records one row per candidate in reflection_candidate_batches under an idempotent batch origin key, and one adoption row whose foreign key requires a built candidate, written after the promotion so a retry heals a lost row.",
    "invariants_preserved": [
      "Skill versions stay immutable and numbered in order.",
      "A round's suggestions keep one owner and the existing decide ledger.",
      "Model calls and debits stay in Go through the gateway."
    ],
    "rejected_alternatives": [
      "Keeping candidates outside skill_versions, which would need a second run and download path.",
      "An origin key on held versions, redundant with content-hash dedup inside the save transaction.",
      "Writing the adoption before the promotion, which could name a candidate the line never took."
    ],
    "proof_obligations": [
      "rule-a-held-version-stays-outside-its-skills-line-until-promoted",
      "held-not-released-and-no-round",
      "evaluate-then-adopt",
      "rule-a-held-version-is-promoted-only-while-the-line-still-ends-at-its-base",
      "rule-a-round-keeps-a-candidate-on-development-cases-and-recommends-one-on-held-out-cases",
      "rule-evaluating-a-rounds-candidates-accepts-its-pending-suggestions",
      "rule-a-round-adopts-at-most-one-built-candidate",
      "retries-heal"
    ],
    "counterfactual_check": "Let a held save index the Skill; evaluate-then-adopt must fail. Drop the publishing held check; held-not-released-and-no-round must fail. Let Promote ignore the base; the promotion rule must fail. Stop recording rejected ids for an unbuilt candidate; the accept rule must fail."
  },
  "event_change": null,
