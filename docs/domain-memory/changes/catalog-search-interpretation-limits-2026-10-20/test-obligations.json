{
  "format": "domain-test-obligations/v1",
  "requirement_id": "catalog-search-interpretation-limits-2026-10-20",
  "proposal_id": "catalog-search-interpretation-limits-2026-10-20",
  "obligations": [
    {
      "id": "rule-a-model-extracted-search-intent-quotes-the-query",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-model-extracted-search-intent-quotes-the-query",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-model-extracted-search-intent-quotes-the-query"
        }
      ],
      "expected_outcome": "A search intent the model extracted is accepted only when every filled field appears verbatim in the person's query and none is blank or over 2000 characters; a person's own correction need not quote the original query.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestIntentValidationRejectsIncompleteInventedAndOversizedProposals$ ./internal/skill/discovery/"
    },
    {
      "id": "rule-a-search-interpretation-has-at-most-8-keywords-of-128-characters",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-search-interpretation-has-at-most-8-keywords-of-128-characters",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-search-interpretation-has-at-most-8-keywords-of-128-characters"
        }
      ],
      "expected_outcome": "A search interpretation holds at most 8 keywords, each non-blank and at most 128 characters; exactly 8 keywords of 128 characters are accepted.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestIntentLimitsAcceptTheBoundaryAndUserCorrectionsNeedNotQuoteOriginal$ ./internal/skill/discovery/"
    },
    {
      "id": "rule-a-corrected-search-is-at-most-2000-characters-combined",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-corrected-search-is-at-most-2000-characters-combined",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-corrected-search-is-at-most-2000-characters-combined"
        }
      ],
      "expected_outcome": "A search the person corrected is refused when its intent fields and keywords together exceed 2000 characters; exactly 2000 is accepted.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -v -run ^TestCorrectedIntentCombinedTextLimit$ ./internal/skill/discovery/"
    }
  ]
}
