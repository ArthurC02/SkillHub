  "implementation_design": {
    "domain_forces": [
      "A blind extraction of the credit Context found ten enforced rules; the reviewed Registry held none, so the next Agent could not look them up.",
      "One of them, refusing a reused grant key, had no test at all."
    ],
    "decision": "Record the ten rules as reviewed citing code and test; add the integration test for the reused grant key.",
    "invariants_preserved": [
      "A balance changes only through a ledger entry."
    ],
    "rejected_alternatives": [
      "Citing the balance CHECK constraint in db/migrations: it is outside the confirmed sources; the Go mapping and its integration test carry the rule.",
      "Recording the start threshold from cost statistics: its fallback rules are tuning, not a rule a creator or operator would name."
    ],
    "proof_obligations": [
      "rule-only-an-adjustment-may-lower-a-balance",
      "rule-a-grant-needs-a-nonzero-amount-a-reason-and-an-accountable-operator",
      "rule-a-balance-never-goes-below-the-lowest-stored-balance",
      "rule-replaying-a-grant-key-applies-and-audits-once",
      "rule-a-grant-key-reused-for-a-different-entry-is-refused",
      "rule-a-charge-is-debited-once-per-idempotency-key",
      "rule-usage-with-unknown-cost-is-recorded-but-never-debited",
      "rule-a-step-is-affordable-only-above-the-debt-floor",
      "rule-an-unpriceable-amount-is-refused-never-billed-as-free",
      "rule-a-purged-or-missing-account-cannot-be-charged-or-granted"
    ],
    "counterfactual_check": "Break each rule's enforcing line so the package still builds; its test must fail with that rule's own assertion."
  },
