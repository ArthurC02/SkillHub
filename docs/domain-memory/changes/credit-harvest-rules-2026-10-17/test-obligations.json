{
  "format": "domain-test-obligations/v1",
  "requirement_id": "credit-harvest-rules",
  "proposal_id": "credit-harvest-rules",
  "obligations": [
    {
      "id": "rule-only-an-adjustment-may-lower-a-balance",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-only-an-adjustment-may-lower-a-balance",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "only-an-adjustment-may-lower-a-balance"
        }
      ],
      "expected_outcome": "An operator entry with negative credits is refused with ErrGrantLowersBalance unless it is an adjustment.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestOnlyAnAdjustmentMayLowerABalance$ ./internal/creator/credit/"
    },
    {
      "id": "rule-a-grant-needs-a-nonzero-amount-a-reason-and-an-accountable-operator",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-grant-needs-a-nonzero-amount-a-reason-and-an-accountable-operator",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-grant-needs-a-nonzero-amount-a-reason-and-an-accountable-operator"
        }
      ],
      "expected_outcome": "An operator entry is refused when its credits are zero, its trimmed reason is empty, or its user, operator or idempotency key is missing; its kind must be grant, topup or adjustment.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestGrantRequiresReasonAndOperator$ ./internal/creator/credit/"
    },
    {
      "id": "rule-a-balance-never-goes-below-the-lowest-stored-balance",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-balance-never-goes-below-the-lowest-stored-balance",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-balance-never-goes-below-the-lowest-stored-balance"
        }
      ],
      "expected_outcome": "An entry that would take a balance below MinBalanceCredits is refused with ErrBalanceOutOfRange and nothing is applied; landing exactly on the minimum is applied.",
      "level": "integration",
      "status": "planned",
      "check": "go test -count=1 -run ^TestAnAdjustmentIsRefusedExactlyWhenItWouldPassTheLowestStoredBalance$ ./internal/creator/credit/"
    },
    {
      "id": "rule-replaying-a-grant-key-applies-and-audits-once",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-replaying-a-grant-key-applies-and-audits-once",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "replaying-a-grant-key-applies-and-audits-once"
        }
      ],
      "expected_outcome": "Re-submitting an operator entry under the same idempotency key returns the current balance without applying it or writing a second audit entry.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestReplayingAGrantKeyGrantsAndAuditsOnce$ ./internal/creator/credit/"
    },
    {
      "id": "rule-a-grant-key-reused-for-a-different-entry-is-refused",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-grant-key-reused-for-a-different-entry-is-refused",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-grant-key-reused-for-a-different-entry-is-refused"
        }
      ],
      "expected_outcome": "An idempotency key already used for an operator entry is refused with ErrGrantKeyReused when it is presented with another kind or another amount, and the balance is unchanged.",
      "level": "integration",
      "status": "planned",
      "check": "go test -count=1 -run ^TestAGrantKeyReusedForADifferentEntryIsRefusedAndLeavesTheBalance$ ./internal/creator/credit/"
    },
    {
      "id": "rule-a-charge-is-debited-once-per-idempotency-key",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-charge-is-debited-once-per-idempotency-key",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-charge-is-debited-once-per-idempotency-key"
        }
      ],
      "expected_outcome": "Replaying a charge under the same idempotency key reports it as existing and leaves one cost event, one ledger entry and one debit.",
      "level": "integration",
      "status": "planned",
      "check": "go test -count=1 -run ^TestAReplayedChargeKeyRecordsAndDebitsOnce$ ./internal/creator/credit/"
    },
    {
      "id": "rule-usage-with-unknown-cost-is-recorded-but-never-debited",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-usage-with-unknown-cost-is-recorded-but-never-debited",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "usage-with-unknown-cost-is-recorded-but-never-debited"
        }
      ],
      "expected_outcome": "A charge whose actual cost is unknown is recorded as an estimated cost event and debits no credits; the reserved ceiling is never billed as the cost.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestUnknownUsageIsRecordedAndNeverDebited$ ./internal/creator/credit/"
    },
    {
      "id": "rule-a-step-is-affordable-only-above-the-debt-floor",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-step-is-affordable-only-above-the-debt-floor",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-step-is-affordable-only-above-the-debt-floor"
        }
      ],
      "expected_outcome": "A paid step may proceed only when the balance minus the credits billed for its reservation stays at or above the configured debt floor.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestCanAffordStepEnforcesDebtFloor$ ./internal/creator/credit/"
    },
    {
      "id": "rule-an-unpriceable-amount-is-refused-never-billed-as-free",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-an-unpriceable-amount-is-refused-never-billed-as-free",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "an-unpriceable-amount-is-refused-never-billed-as-free"
        }
      ],
      "expected_outcome": "A cost or markup outside its billable range is refused with ErrAmountOutOfRange instead of overflowing, and billing rounds up, never down.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestAnAmountTooLargeToPriceIsAnErrorNotZero$ ./internal/creator/credit/"
    },
    {
      "id": "rule-a-purged-or-missing-account-cannot-be-charged-or-granted",
      "source_type": "acceptance-criterion",
      "source_id": "enforced-a-purged-or-missing-account-cannot-be-charged-or-granted",
      "also_covers": [
        {
          "source_type": "rule",
          "source_id": "a-purged-or-missing-account-cannot-be-charged-or-granted"
        }
      ],
      "expected_outcome": "When account facts report the user missing or purged, a grant and a charge are refused with ErrAccountGone and nothing is recorded.",
      "level": "unit",
      "status": "planned",
      "check": "go test -count=1 -run ^TestFactsBlockPurgedAccountOnCharge$ ./internal/creator/credit/"
    }
  ]
}
