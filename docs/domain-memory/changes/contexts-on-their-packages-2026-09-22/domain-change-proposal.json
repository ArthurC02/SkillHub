  "ownership_decision": {
    "owner_context": "run",
    "invariant": "A Go package under apps/platform/internal belongs to exactly one Bounded Context.",
    "evidence": [
      "apps/platform/internal/trial/execution/doc.go:1"
    ]
  },
  "boundary_decision": {
    "interaction": "Unchanged. This narrows what each record rests on and alters no collaboration.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": [
      "docs/adr/ADR-016-platform-bounded-contexts-and-context-map.md:16"
    ]
  },
  "implementation_design": {
    "domain_forces": [
      "Citing the architecture identity file put it in the Registry's source corpus, and source verification compares whole-file snapshots, so adding any package turned the machine checks red until a human re-confirmed the corpus.",
      "A tool whose job is to confirm facts must not make routine work fail.",
      "The directory a package occupies is proved by the path of the doc comment being cited, so a second citation into a layout file adds a dependency without adding evidence."
    ],
    "decision": "Cite only the owning package's doc comment, and let the machine checks read the Registry directly instead of treating layout data as a source to corroborate against.",
    "invariants_preserved": [
      "A Go package under apps/platform/internal belongs to exactly one Bounded Context."
    ],
    "rejected_alternatives": [
      "Keep the layout citation and re-confirm the corpus each time: that is the cost being removed, paid forever.",
      "Drop implementation_path from the records: the machine checks are about to read it from here, so it is the one place it should live.",
      "Keep both the Registry and the layout file authoritative for the thirteen Contexts: one fact with two homes drifts."
    ],
    "proof_obligations": [
      "registry-structurally-valid",
      "cited-evidence-current",
      "no-record-cites-layout-data",
      "editing-layout-data-leaves-sources-current",
      "no-two-contexts-claim-one-path",
      "audit-chain-intact",
      "approval-path-is-external"
    ],
    "counterfactual_check": "no-two-contexts-claim-one-path"
  },
