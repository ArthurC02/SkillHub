  "contract_ids": [],
  "ownership_decision": {
    "owner_context": "identity",
    "invariant": "The identity callback decides why a sign-in failed and reports it only as one of a closed set of login_error codes.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "Browser navigation from GitHub to the identity callback, then to the app address",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "The callback is a top-level browser navigation, so a JSON body strands the person on an API address.",
      "An outage must not read as a bad credential."
    ],
    "decision": "Redirect (303) every callback failure to the configured app address with a login_error code; keep internal detail in the log.",
    "invariants_preserved": [
      "The state check still runs before any code exchange.",
      "An outage and a refusal still map to different outcomes."
    ],
    "rejected_alternatives": [
      "An HTML error page served by the API: still leaves the app and duplicates its copy.",
      "Putting the sentence in the query string: reflects server text into the page and cannot be localised by the app."
    ],
    "proof_obligations": [
      "outage-is-not-a-refusal",
      "state-mismatch-is-expired"
    ],
    "counterfactual_check": "Mapping ErrGitHubUnavailable to github_refused, or dropping the state comparison, turns the named tests red."
  },
  "event_change": null,
  "contract_change": null,
