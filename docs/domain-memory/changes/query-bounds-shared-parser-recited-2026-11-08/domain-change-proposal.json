  "ownership_decision": {
    "owner_context": "discovery",
    "invariant": "Each list endpoint keeps its own limit and offset bounds; the shared parser only reads the one value and checks it against the bounds the endpoint passes.",
    "evidence": []
  },
  "boundary_decision": {
    "interaction": "unchanged; each handler passes its own bounds to httpx.QueryInt32, a generic helper, so no context depends on another.",
    "consistency": "synchronous",
    "prohibited_dependencies": [],
    "evidence": []
  },
  "implementation_design": {
    "domain_forces": [
      "Seven handlers parsed limit and offset by hand with different wording, and the activity feed read an empty limit as the default and a repeated cursor as its first value."
    ],
    "decision": "Re-cite the five rules to the handlers' current lines; the rule texts are unchanged and still hold.",
    "invariants_preserved": [
      "Each endpoint's bounds are the ones its rule states.",
      "An empty or out-of-range value is refused, never replaced by the default."
    ],
    "rejected_alternatives": [
      "Leaving the stale citations, which would fail verify-evidence."
    ],
    "proof_obligations": [
      "rule-a-search-limit-is-1-to-100",
      "rule-a-skill-listing-page-stays-in-bounds",
      "rule-a-test-case-list-limit-is-1-to-101",
      "rule-a-test-case-list-offset-is-0-to-the-int32-ceiling",
      "rule-an-activity-page-limit-is-1-to-100"
    ],
    "counterfactual_check": "Let QueryInt32 accept a value one past its upper bound: the activity limit rule's test must fail."
  },
