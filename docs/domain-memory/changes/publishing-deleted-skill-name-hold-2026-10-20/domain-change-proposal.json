  "implementation_design": {
    "domain_forces": [
      "A deleted Skill held its publication name forever, and releasing it at once would send old links to different content."
    ],
    "decision": "Retire the publication on the skill.deleted event; hold the name 90 days inside the publisher, then release it to the same publisher.",
    "invariants_preserved": [
      "Each rule statement matches the code it cites."
    ],
    "rejected_alternatives": [
      "Releasing the name at once: an old link would lead to the publisher's different content without warning."
    ],
    "proof_obligations": [
      "rule-a-deleted-skills-publication-name-is-held-ninety-days"
    ],
    "counterfactual_check": "Each rule's protection is broken in turn and the rule's own test fails; the evidence bundle's counterfactual_check list records every run."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-deleted-skills-publication-name-is-held-ninety-days",
        "statement": "When a published Skill is deleted its publication retires; for 90 days after that its old address still answers withdrawn and the publisher cannot give its name to another Skill; after 90 days the name passes to another of the same publisher's Skills and the address follows it.",
        "contexts": [
          "publishing"
        ],
        "examples": [
          "Reusing the name 89 days 23 hours after the delete answers 409 name_held; 90 days and a minute after, it publishes and the old address serves the successor."
        ],
