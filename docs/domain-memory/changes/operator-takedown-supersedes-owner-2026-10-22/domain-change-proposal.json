  "implementation_design": {
    "domain_forces": [
      "An operator answering a violation got 409 on a Skill its owner had taken down, and the owner could then restore the violating Skill with no operator takedown on record."
    ],
    "decision": "Let an operator's takedown replace the owner's, in the aggregate and in the guarded update.",
    "invariants_preserved": [
      "An owner restores only their own takedown within thirty days.",
      "A takedown needs a reason."
    ],
    "rejected_alternatives": [
      "Answering 409 and asking the operator to watch the Skill: the owner's restore window stays open."
    ],
    "proof_obligations": [
      "rule-a-skill-is-taken-down-once"
    ],
    "counterfactual_check": "Reverting the operator exception in TakeDown fails TestOnlyAnOperatorTakedownSupersedesAnOwnersOwn; reverting the SQL guard fails TestAnOperatorTakedownSupersedesTheOwnersOwnSoTheOwnerCannotUndoIt with 500."
  },
  "event_change": null,
  "contract_change": null,
  "registry_updates": [
    {
      "operation": "upsert",
      "asset": "rules",
      "record": {
        "id": "a-skill-is-taken-down-once",
        "statement": "A Skill already taken down cannot be taken down again, except that an operator's takedown supersedes the owner's own: the Skill stays down, now as the operator's, and only an operator lifts it. Any other second attempt is refused and the Skill stays down.",
        "contexts": [
          "registry"
        ],
        "examples": [
          "A second report against a taken-down Skill is refused as already_taken_down.",
          "An operator taking down a Skill its owner already took down succeeds; the owner can no longer restore it."
        ],
