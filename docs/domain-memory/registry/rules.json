    {
      "id": "batch-waits-only-on-a-passing-refusal",
      "contexts": [
        "batch"
      ],
      "statement": "An evaluation batch waits when Run refuses a trial with a refusal Run says will pass on its own, and stops with that reason recorded on any other refusal.",
      "examples": [
        "The workspace is already running as many runs as it may: the batch tries the trial again on its next advance.",
        "The credit balance is too low: the batch stops and records credit_balance as its reason."
      ],
