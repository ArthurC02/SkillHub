# Skill Hub local-development template.
# Copy with `task env:init` (or `go -C tools/devctl run . env-init`).
# Values below are local-only placeholders. Keep every secret blank until its
# profile is intentionally enabled; never commit the resulting .env file.

# Core profile: platform and local infrastructure
DATABASE_URL=postgres://skillhub:skillhub@localhost:5432/skillhub?sslmode=disable
APP_URL=http://localhost:5173
DEV_CORS_ORIGIN=http://localhost:5173
COOKIE_INSECURE=1
DEV_LOGIN=1
OPERATOR_USER_IDS=
BETA_ALLOWLIST=
IMPORT_ALLOW_INSECURE=1
IMPORT_EXTRA_HOSTS=localhost,127.0.0.1
OBJSTORE_ENDPOINT=localhost:8333
OBJSTORE_ACCESS_KEY=skillhubdev
OBJSTORE_SECRET_KEY=skillhubdevsecret
OBJSTORE_BUCKET=skillhub
OBJSTORE_SSL=0
LLM_SERVICE_URL=
# Required whenever LLM_SERVICE_URL is set. Shared only by the Go control plane
# and the internal Python LLM service; never expose it to sandbox workloads.
LLM_SERVICE_TOKEN=
METRICS_ADDR=
DOWNLOAD_ARTIFACT_RETENTION=
ANALYTICS_RETENTION=
RUN_QUOTA=

# GitHub OAuth is optional when DEV_LOGIN=1. Keep production credentials blank.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=

# Model profile: required only for LiteLLM-backed operations.
# Provider credentials belong to the LiteLLM process only (ADR-017).
OPENAI_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=

# Run and sandbox profile: opt-in and potentially paid.
SKILLHUB_SANDBOX_PROVIDERS=
SKILLHUB_SANDBOX_TOKEN=
SKILLHUB_SANDBOX_RUNTIME=
SKILLHUB_SANDBOX_NETWORK=
SKILLHUB_MODEL_GATEWAY_URL=http://localhost:4000
SKILLHUB_MODEL_GATEWAY_ADMIN_URL=http://localhost:4000
SKILLHUB_MODEL_GATEWAY_KEY=
SKILLHUB_RUN_MODEL=gpt-5.4-mini
SKILLHUB_RUN_MAX_BUDGET_USD=0.50
SKILLHUB_RUN_TPM_LIMIT=200000
SKILLHUB_TRACE_INGEST_URL=http://localhost:8080
SKILLHUB_TRACE_INGEST_SECRET=

# Tests: intentionally blank so normal tests cannot spend money by accident.
# SKILLHUB_TEST_DATABASE_URL needs a separately created test database.
SKILLHUB_TEST_DATABASE_URL=
SKILLHUB_E2E_SANDBOX_URL=
SKILLHUB_E2E_SANDBOX_TOKEN=
SKILLHUB_E2E_GATEWAY_URL=
SKILLHUB_E2E_GATEWAY_KEY=
SKILLHUB_E2E_EGRESS_NETWORK=
SKILLHUB_E2E_RUNTIME_IMAGE=
QA002_CORPUS=
