{
  "name": "SkillHub",
  "build": {
    "context": "..",
    "dockerfile": "../infra/images/devtools/Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "waitFor": "postCreateCommand",
  "mounts": [
    "source=skillhub-devcontainer-docker,target=/var/lib/docker,type=volume"
  ],
  "runArgs": ["--privileged"],
  "remoteUser": "vscode",
  "forwardPorts": [5173, 8080, 4000, 8333, 5432],
  "portsAttributes": {
    "5173": {
      "label": "SkillHub Web",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "SkillHub Platform API",
      "onAutoForward": "notify"
    },
    "4000": {
      "label": "LiteLLM gateway",
      "onAutoForward": "silent"
    },
    "8333": {
      "label": "SeaweedFS S3 API",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", ".devcontainer/README.md"]
    },
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "go.toolsManagement.checkForUpdates": "off",
        "python.defaultInterpreterPath": "${workspaceFolder}/apps/llm/.venv/bin/python",
        "python.testing.pytestArgs": ["apps/llm"],
        "python.testing.pytestEnabled": true,
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "golang.go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  }
}
