#!/bin/sh
set -eu
set -a
. /etc/skillhub/release.env
set +a
here=/opt/skillhub/infra/deploy

docker compose version >/dev/null 2>&1 || "$here/common/install-docker"
install -d -m 0700 /etc/skillhub/secrets
envsubst '${SKILLHUB_SMTP_SMARTHOST} ${SKILLHUB_SMTP_FROM} ${SKILLHUB_SMTP_USERNAME} ${SKILLHUB_ALERT_EMAIL}' \
    <"$here/control-plane/alertmanager.yml.tmpl" >/etc/skillhub/alertmanager.yml
install -m 0644 "$here"/control-plane/systemd/* /etc/systemd/system/
systemctl daemon-reload
systemctl enable skillhub.service
echo "skillhub-bootstrap: control plane installed; place the secrets in /etc/skillhub/secrets, then systemctl start skillhub"
