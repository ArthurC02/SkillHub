[Unit]
Description=Skill Hub restore drill from the newest backup
Requires=skillhub.service
After=skillhub.service
OnFailure=skillhub-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose --env-file /etc/skillhub/release.env -f /opt/skillhub/infra/compose/control-plane.yml --profile jobs run --rm --no-deps restore-drill
