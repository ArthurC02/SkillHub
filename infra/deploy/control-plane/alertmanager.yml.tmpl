global:
  smtp_smarthost: "${SKILLHUB_SMTP_SMARTHOST}"
  smtp_from: "${SKILLHUB_SMTP_FROM}"
  smtp_auth_username: "${SKILLHUB_SMTP_USERNAME}"
  smtp_auth_password_file: /etc/alertmanager/smtp-password
  smtp_require_tls: true

route:
  receiver: owner
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="critical"']
      receiver: owner
      repeat_interval: 1h

receivers:
  - name: owner
    email_configs:
      - to: "${SKILLHUB_ALERT_EMAIL}"
        send_resolved: true
