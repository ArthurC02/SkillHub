#!/bin/sh
set -eu
baseline="$(awk '!/^#/ && NF { print $1; exit }' /opt/skillhub/infra/nodes/gvisor-baseline.txt)"
case "$baseline" in
    release-*) ;;
    *)
        echo "install-gvisor: infra/nodes/gvisor-baseline.txt holds '$baseline', not a gVisor release" >&2
        exit 1
        ;;
esac
url="https://storage.googleapis.com/gvisor/releases/release/${baseline#release-}/$(uname -m)"
work="$(mktemp -d)"
cd "$work"
for file in gvisor.tar.zstd gvisor.tar.zstd.sha512; do
    curl -fsSL -o "$file" "$url/$file"
done
sha512sum -c gvisor.tar.zstd.sha512
tar --zstd -xf gvisor.tar.zstd -C /usr/local/bin
cd /
rm -rf "$work"
runsc --version
