#!/bin/sh
set -eu
file=/opt/skillhub/infra/nodes/gvisor-baseline.txt
baseline="$(awk '!/^#/ && NF { print $1; exit }' "$file")"
case "$baseline" in
    release-*) ;;
    *)
        echo "install-gvisor: infra/nodes/gvisor-baseline.txt holds '$baseline', not a gVisor release" >&2
        exit 1
        ;;
esac
arch="$(uname -m)"
expected="$(awk -v a="$arch" '$1 == "sha512" && $2 == a { print $3 }' "$file")"
if [ -z "$expected" ]; then
    echo "install-gvisor: no sha512 pinned for $arch in $file" >&2
    exit 1
fi
url="https://storage.googleapis.com/gvisor/releases/release/${baseline#release-}/$arch"
work="$(mktemp -d)"
cd "$work"
curl -fsSL -o gvisor.tar.zstd "$url/gvisor.tar.zstd"
echo "$expected  gvisor.tar.zstd" | sha512sum -c -
tar --zstd -xf gvisor.tar.zstd -C /usr/local/bin
cd /
rm -rf "$work"
runsc --version
