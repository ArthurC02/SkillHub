#!/bin/sh
set -eu
: "${WALG_S3_PREFIX:?WALG_S3_PREFIX is not set, so there is nowhere to send the backup}"
if [ -n "${WALG_RETAIN_FULL:-}" ]; then
    echo "skillhub-backup: WALG_RETAIN_FULL is no longer read; set WALG_RETAIN_DAYS instead" >&2
    exit 1
fi
retain_days="${WALG_RETAIN_DAYS:-35}"
case "$retain_days" in
    '' | *[!0-9]* | 0*) echo "skillhub-backup: WALG_RETAIN_DAYS must be a whole number of days, at least 1" >&2; exit 1 ;;
esac
export PGHOST=/var/run/postgresql PGUSER="${POSTGRES_USER:-postgres}"
gosu postgres wal-g backup-push "$PGDATA"
gosu postgres wal-g delete before FIND_FULL "$(date -u -d "$retain_days days ago" +%Y-%m-%dT%H:%M:%SZ)" --confirm
